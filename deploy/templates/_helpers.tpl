{{/*
_helpers.tpl — именованные шаблоны чарта.
*/}}

{{/*
kaname-svc.authMode — посадка безопасности, ОДНИМ адресом.

Ручку звали в дереве шестью разными адресами и двумя именами: `authn.mode`,
`config.authn.mode`, `auth.mode`, `config.mode`, `config.authMode`, `authMode`.
Ночью первый вопрос оператора — «в какой посадке работает этот кластер», и
задать его одной командой по одному ключу было НЕЛЬЗЯ: надо знать семь адресов.
Ужесточить флот одним `--set` тоже нельзя — путей столько же, сколько сервисов.

Канон — `authMode` в корне значений сервиса (camelCase, как прочие ключи
продукта; так уже было объявлено у registry и geo).

Это ПЕРЕИМЕНОВАНИЕ ПОД ОХРАНОЙ, а не совместимость: канон объявлен умолчанием
чарта, поэтому профиль, задающий прежний адрес, даёт расхождение и отказ
рендера с обоими значениями в тексте. Гарантия здесь одна и ради неё всё:
молчаливого отката к умолчанию чарта НЕ БУДЕТ. Для ручки, задающей посадку
безопасности, такой откат означал бы стенд, который называет себя одним, а
работает другим, — и заметить это можно только по последствиям.
*/}}
{{- define "kaname-svc.authMode" -}}
{{- $vals := .Values | toYaml | fromYaml -}}
{{- $canonRaw := .Values.authMode -}}
{{- $legacyRaw := "" -}}
{{- $cur := $vals -}}
{{- if kindIs "map" $cur }}{{ $cur = dig "authn" (dict) $cur }}{{ else }}{{ $cur = dict }}{{ end -}}
{{- if kindIs "map" $cur }}{{ $legacyRaw = dig "mode" "" $cur }}{{ end -}}
{{- $canon := "" -}}{{- if $canonRaw }}{{ $canon = printf "%v" $canonRaw }}{{ end -}}
{{- $legacy := "" -}}{{- if $legacyRaw }}{{ $legacy = printf "%v" $legacyRaw }}{{ end -}}
{{- if and (ne $canon "") (ne $legacy "") (ne $canon $legacy) -}}
{{- fail (printf "authMode=%q и прежний адрес authn.mode=%q заданы одновременно и различаются: какой из двух адресов задаёт посадку — решает оператор, а не шаблон. Оставьте один, канон — authMode" $canon $legacy) -}}
{{- end -}}
{{- if ne $canon "" }}{{ $canon }}{{ else }}{{ $legacy }}{{ end -}}
{{- end -}}

{{/*
kaname-svc.requireOperatorSuppliedNames — ОТКАЗ УСТАНОВКИ ОДНИМ ПЕРЕЧНЕМ, когда
не названы координаты, которых этот чарт НЕ ЗАВОДИТ.

ЧТО ОН ЗАПРЕЩАЕТ. Он запрещает установку, в которой координата, принадлежащая
ЧУЖОМУ кластеру, не названа оператором. Умолчания у таких величин нет намеренно:
непустое умолчание всегда выглядит настроенным и всегда ведёт в никуда — оно
называло бы объект НАШЕЙ установки, которого у ставящего нет. Здесь стояли имена
зонтичного релиза (`kacho-umbrella-pg-iam`), и отказ приходил уже в кластере:
`secret "kacho-umbrella-pg-iam" not found`.

КООРДИНАТ ДВА РОДА, и второй заведён задачей #2094. Первый — ИМЕНА ОБЪЕКТОВ
кластера, которых чарт не создаёт (узел базы, секрет с паролем). Второй —
КООРДИНАТА ОБРАЗА в реестре: объектом Kubernetes она не является, а класс тот
же и на шаг дальше. Здесь стоял тег нашего стенда (`kaname:dev`) — артефакт
локальной сборки, которого в чужом реестре нет и быть не может, — и отказ
приходил ещё позже, уже на вытягивании образа:
`Failed to pull image "kaname:dev": pull access denied  (Init:ImagePullBackOff)`.
Отказ, приходящий в кластере, дороже отказа установки на порядок: до него надо
доехать.

ПОЧЕМУ ПЕРЕЧНЕМ, А НЕ `required` НА КАЖДОМ КЛЮЧЕ. `required` роняет рендер на
ПЕРВОМ незаданном, и оператор узнаёт о недостающем по одному за перекат: задал —
получил следующий отказ — задал снова. Здесь собираются ВСЕ незаданные и
называются разом.

ЧТО НАЗЫВАЕТ ОТКАЗ: ключ профиля · путь подачи · что сделать дальше. Путь
подачи объявлен ЧЕСТНО: у координат секрета переменной окружения НЕТ — они живут
только в профиле чарта, и назвать несуществующую переменную значило бы дать
оператору способ, который величину не задаёт.

ОБЛАСТЬ НАЗВАНА: он судит имена ЧУЖИХ объектов и НЕ судит посадку безопасности —
её судит страж старта процесса (`Config.Validate`), у которого свой перечень.
*/}}
{{- define "kaname-svc.requireOperatorSuppliedNames" -}}
{{- $db := .Values.db | default dict -}}
{{- $missing := list -}}
{{- if not .Values.image -}}
{{- $missing = append $missing "  image                  — координата образа службы в ВАШЕМ реестре (`<реестр>/<путь>:<тег>`).\n                           Умолчания нет намеренно: тег нашего стенда читался бы настройкой\n                           и отказал бы уже на вытягивании образа (ImagePullBackOff)." -}}
{{- end -}}
{{- if not $db.host -}}
{{- $missing = append $missing "  db.host                — сетевое имя узла Postgres (Service/DNS-имя вашего кластера).\n                           Подаётся также переменной KANAME_REPOSITORY__POSTGRES__URL — адресом целиком." -}}
{{- end -}}
{{- if not $db.passwordSecretName -}}
{{- $missing = append $missing "  db.passwordSecretName  — имя объекта Secret с паролем к этой базе.\n                           Переменной окружения НЕТ: величина живёт только в профиле чарта." -}}
{{- end -}}
{{- if not $db.passwordSecretKey -}}
{{- $missing = append $missing "  db.passwordSecretKey   — ключ внутри этого Secret, под которым лежит пароль.\n                           Переменной окружения НЕТ: величина живёт только в профиле чарта." -}}
{{- end -}}
{{/* КООРДИНАТЫ TLS — ОБЯЗАТЕЛЬНЫ ОТ АНТЕЦЕДЕНТА, А НЕ ВСЕГДА (#2488).

Перечень судил четыре координаты, а текст его отказа утверждал, что чарт «не
заводит ни образа, ни базы, НИ СЕКРЕТОВ» — обобщённо. Секреты TLS, которых чарт
ровно так же не создаёт и чьи имена он ровно так же подставляет в манифест, из
перечня выпадали: при незаданных тома нет, а пути в карте `env` остаются, и
процесс получает координату файла, которого в поде не существует.

БЕЗУСЛОВНОЕ ТРЕБОВАНИЕ ОТВЕРГНУТО. Посадка без TLS законна — её отвергает страж
СТАРТА процесса, а не рендер, — и безусловный отказ здесь решал бы за автора
профиля то, чего он не решал.

АНТЕЦЕДЕНТ: карта `env` НАЗЫВАЕТ ФАЙЛ под каталогом этого тома. Тогда координата
и есть та половина пары «адрес + удостоверение», которая выглядит настроенной и
не работает. Антецедент самоистекает: перестал профиль называть файлы под
каталогом — обязательность снялась сама.

ТРИ ЗАПИСИ, А НЕ ОБХОД ПО СПИСКУ, и это решение. Обход даёт условие с
вычисляемым ключом (`get $tls $lane.knob`) и текст, собранный `printf`-ом из
переменной, — то есть форму, в которой ни одна проверка не увидит НИ ИМЕНИ
координаты, ни того, что она вообще стережётся. Три записи той же формы, что и
четыре выше, читаются и человеком, и гейтом
(`operator_supplied_roster_test.go`). */}}
{{- $tls := .Values.tls | default dict -}}
{{- $mount := $tls.mountPath | default "" -}}
{{- $envs := .Values.env | default dict -}}
{{- $namesServer := "" -}}
{{- $namesClient := "" -}}
{{- $namesProvider := "" -}}
{{- if $mount -}}
{{- range $k, $v := $envs -}}
{{- $val := printf "%v" $v -}}
{{- if contains (printf "%s/server/" $mount) $val -}}{{- $namesServer = $k -}}{{- end -}}
{{- if contains (printf "%s/client/" $mount) $val -}}{{- $namesClient = $k -}}{{- end -}}
{{- if contains (printf "%s/provider/" $mount) $val -}}{{- $namesProvider = $k -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- if and $namesServer (not $tls.secretName) -}}
{{- $missing = append $missing (printf "  tls.secretName         — имя объекта Secret с серверным листом слушателей (`tls.crt`, `tls.key`)\n                           и кругом клиентских листов (`ca.crt`).\n                           Обязательна ЗДЕСЬ потому, что профиль называет файл под %s/server/ (например %s):\n                           без имени тома нет, путь остаётся, и процесс получает координату файла, которого\n                           в поде не существует — отказ пришёл бы уже в кластере." $mount $namesServer) -}}
{{- end -}}
{{- if and $namesClient (not $tls.clientSecretName) -}}
{{- $missing = append $missing (printf "  tls.clientSecretName   — имя объекта Secret с КЛИЕНТСКИМ листом: им служба представляется,\n                           когда звонит сама (назначение `client auth`, отдельный лист от серверного).\n                           Обязательна ЗДЕСЬ потому, что профиль называет файл под %s/client/ (например %s)." $mount $namesClient) -}}
{{- end -}}
{{- if and $namesProvider (not $tls.providerSecretName) -}}
{{- $missing = append $missing (printf "  tls.providerSecretName — имя объекта Secret с ЯКОРЕМ доверия к серверным сертификатам ВАШЕГО\n                           поставщика личности. Это ДРУГАЯ величина, чем круг клиентских листов выше:\n                           «чьим сертификатам сервера я верю у соседа» против «кто вправе прийти ко мне».\n                           Обязательна ЗДЕСЬ потому, что профиль называет файл под %s/provider/ (например %s)." $mount $namesProvider) -}}
{{- end -}}
{{- if $missing -}}
{{- fail (printf "чарт службы прав не ставится: НЕ НАЗВАНО координат — %d.\n\nЭтот чарт создаёт свои объекты (Deployment, Service, ConfigMap %s-config и, при включённой ручке alertRules, PrometheusRule) и НЕ заводит ни образа, ни базы, ни секретов. Всё, на что он ссылается за своими объектами, заводит тот, кто ставит, — и называет здесь. Умолчания у этих ключей нет намеренно: непустое умолчание называло бы объект нашей установки, которого у вас нет, выглядело бы настройкой и отказало бы уже в кластере.\n\n%s\n\nЧТО СДЕЛАТЬ: заведите эти координаты у себя (объекты — в своём пространстве имён, образ — в своём реестре) и назовите их профилю, например\n  helm install <релиз> <чарт> -f values.yaml \\\n    --set image=<реестр>/pro-robotech/kaname:<тег> \\\n    --set db.host=postgres.<ваше-пространство>.svc \\\n    --set db.passwordSecretName=kaname-db \\\n    --set db.passwordSecretKey=password\nГотовый образец всех величин боевой посадки — values.prod.yaml рядом с чартом."
  (len $missing) .Values.name (join "\n\n" $missing)) -}}
{{- end -}}
{{- end -}}

{{/*
kaname-svc.trustDomain — ДОМЕН ДОВЕРИЯ установки, ОДНИМ написанием.

Собственного сертификата этот чарт не чеканит (его чеканит зонтичный), но
величину принимающей стороны отдаёт процессу он. Объявление живёт здесь по той
же причине, по какой оно живёт у каждого чарта: взятое своей рукой в месте
употребления, оно становится вторым адресом одного предмета — и расходится с
первым молча.

Читается из `authn.trustDomain`, рядом с кругом отправителей, а НЕ из раздела
транспорта: раздела `mtls` у этого чарта нет вовсе, и величина, взятая оттуда,
приезжала бы умолчанием при любом профиле — то есть ручка выглядела бы
настройкой и не настраивала ничего.

УМОЛЧАНИЯ ЗДЕСЬ НЕТ, И ЭТО РЕШЕНИЕ, А НЕ ПРОПУСК. Стояла подстановка домена
доверия НАШЕЙ установки, и дефектов у неё было два, причём второй хуже первого:

  1. чужой бренд у величины, которую оператор чужого облака получает молча;
  2. страж старта, отменённый подстановкой. У этой величины страж ЕСТЬ
     (`config.validateTrustDomain`), он отказывает в пуске на ЛЮБОЙ посадке и
     называет ручку с переменной. Работает он ровно до тех пор, пока незаданное
     доезжает до него незаданным; величина, непустая при любом входе, предметом
     стража быть не может — он зелен всегда.

Цена второго измерима на месте: по чужому домену не опознаётся НИ ОДИН
предъявитель установки, поэтому служба отвергала бы каждого соседа молча, отказом,
неотличимым от вызова без личности. Отказ старта на этом фоне — исход дешевле на
порядок: он приходит сразу и называет, что задать.

Три соседние величины той же полосы (`authn.domain`, `authn.identity-provider`,
`authn.trustedForwarderSANs`) незаданными и доезжают — ветвью в configmap.yaml.
Эта была четвёртой и единственной, кто из полосы выпадал; различия между ними
никто не решал. Держит согласие полосы `boot_guard_defaults_test.go`.
*/}}
{{- define "kaname-svc.trustDomain" -}}
{{- $authn := .Values.authn | default dict -}}
{{- $authn.trustDomain -}}
{{- end -}}

{{/*
kaname-svc.surfacePort — ПОРТ ПОВЕРХНОСТИ, выведенный из адреса, по которому её
поднимает ПРОЦЕСС. Принимает адрес вида `tcp://0.0.0.0:9098`, отдаёт `9098`.

ПОЧЕМУ ВЫВОДИТСЯ, А НЕ ОБЪЯВЛЯЕТСЯ ВТОРОЙ РУЧКОЙ. Дверь у поверхности одна, и
ручка у неё обязана быть одна. Здесь их было две — профиль объявлял АДРЕС
фронта (`apiServer.restEndpoint`), а под и Service читали ПОРТ
(`ports.rest`), — и боевой профиль задал первую, не задав второй: процесс
поднимал дверь, к которой чарт не вёл (задача #2337). Расхождение двух ручек об
одном предмете молчит by construction: каждая по отдельности задана верно.

Выведенный порт разойтись с адресом не может: он и есть этот адрес.
*/}}
{{- define "kaname-svc.surfacePort" -}}
{{- $port := regexFind ":[0-9]+$" (printf "%v" .) | trimPrefix ":" -}}
{{- if not $port -}}
{{- fail (printf "адрес поверхности %q не несёт порта: порт двери выводится из адреса, по которому её поднимает процесс, и вывести его отсюда нельзя. Ожидается форма `tcp://<адрес>:<порт>`" .) -}}
{{- end -}}
{{- $port -}}
{{- end -}}

{{/*
kaname-svc.processDefaultPort — порт поверхности, чей адрес приходит УМОЛЧАНИЕМ
ПРОЦЕССА и потому непуст всегда.

ЗДЕСЬ НЕТ КЛЮЧА ПОСАДКИ, И ЭТО РЕШЕНИЕ. Ключ, двигающий порт Service и
containerPort, но НЕ двигающий сам слушатель, есть объявленная и неисполнимая
возможность: оператор правит ручку, рендер зелёный, процесс слушает прежний
адрес — и Service ведёт в никуда. Ровно такой ключ здесь был у вебхуков
(`ports.hooksHttp`), и не задавал его ни один из трёх профилей.

ЧЕТВЁРТОЙ поверхностью стала диагностика (задача #2394): её `ports.metrics`
двигал порт пода и объявление сбора, а карта настроек адреса метрик не эмитит
вовсе. До той задачи величина `metrics` в словаре ниже стояла БЕЗ ЕДИНОГО
вызывающего — то есть форма была объявлена и не применена ровно там, где её
предмет и жил. Снятый ключ отвергается вслух: `kaname-svc.requireNoRetiredPortKnobs`.

Величины зеркалят `internal/apps/kaname/config/defaults.go`. Согласие с ним
держит не этот комментарий, а гейт `TestServiceRoutesEverySurfaceItRaises`: он
сверяет порт маршрута с адресом, по которому поверхность поднимается,
и на расхождении называет обе величины.
*/}}
{{/*
kaname-svc.requireNoRetiredPortKnobs — СНЯТЫЙ КЛЮЧ ПОСАДКИ ОТВЕРГАЕТСЯ ВСЛУХ.

Ключ, снятый молча, оператору неотличим от работающего: он правит профиль,
рендер зелёный, поведение прежнее — то есть ровно «принято-и-проигнорировано»,
только на поверхности установки. Здесь снят `ports.metrics` (задача #2394), и
снятие обязано быть НАЗВАНО, а не подразумеваться отсутствием ключа в профиле
поставки: `-f своё.yaml` оператора наш профиль не читает.

ЧТО НАЗЫВАЕТ ОТКАЗ: снятый ключ · почему снят · чем двигать предмет теперь.

ПЕРЕЧНЕМ, а не одним `if`: следующий снятый ключ обязан попасть сюда строкой, а
не завести второе место об одном предмете.
*/}}
{{- define "kaname-svc.requireNoRetiredPortKnobs" -}}
{{- $ports := .Values.ports | default dict -}}
{{- $retired := list -}}
{{- if hasKey $ports "metrics" -}}
{{- $retired = append $retired "  ports.metrics — диагностическая поверхность (:9095).\n                  Ключ двигал порт пода и объявление сбора, но НЕ слушатель: адрес\n                  метрик приходит умолчанием процесса, и карты настроек у него нет.\n                  Оператор правил ручку, рендер был зелёным, собиратель шёл в никуда.\n                  ЧЕМ ДВИГАТЬ ТЕПЕРЬ: адресом процесса — переменной\n                  KANAME_API_SERVER__METRICS_ENDPOINT (пустая — слушателя нет вовсе)." -}}
{{- end -}}
{{- if $retired -}}
{{- fail (printf "чарт службы прав не ставится: профиль задаёт СНЯТЫЕ ключи посадки — %d.\n\nКлюч, снятый молча, неотличим от работающего: профиль правится, рендер зелёный,\nповедение прежнее. Поэтому отказ, а не игнорирование.\n\n%s\n\nЧТО СДЕЛАТЬ: уберите ключ из профиля и задайте предмет названным способом." (len $retired) (join "\n\n" $retired)) -}}
{{- end -}}
{{- end -}}

{{- define "kaname-svc.processDefaultPort" -}}
{{- $ports := dict "hooks" "9092" "metrics" "9095" "registryToken" "9096" "jwksProxy" "9097" -}}
{{- $port := index $ports . -}}
{{- if not $port -}}{{- fail (printf "поверхность %q не значится среди тех, чей адрес приходит умолчанием процесса" .) -}}{{- end -}}
{{- $port -}}
{{- end -}}

{{/*
kaname-svc.edgeScheme — СХЕМА ОБРАЩЕНИЯ К РЕБРУ, выведенная из ручки, которая
поднимает его транспорт. Принимает имя ребра (`HOOKS`, `METRICS`, …).

ПОЧЕМУ ВЫВОДИТСЯ. Обращающийся к ребру — проба пода, объявление сбора — говорит,
КУДА идти; включённый транспорт меняет это «куда». Объявление, о нём умолчавшее,
посылает обращающегося открытым текстом на слушатель под TLS, то есть перестаёт
