#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Хук отправки: то, что можно узнать локально, узнаётся ДО конвейера.
#
# ─────────────────────────────────────────────────────────────────────────────
# ЗАЧЕМ ЭТОТ ФАЙЛ ВООБЩЕ ПОЯВИЛСЯ
#
# До него в клонах этого репозитория стоял переходник `.git/hooks/pre-push`,
# который искал ЭТОТ путь, не находил его — каталога `scripts/hooks` в дереве не
# было вовсе, — печатал «проверок НЕ БЫЛО» и выходил НУЛЁМ. Замер (2026-09-22,
# ствол `cbbac984`): отправка прошла за 1.3 секунды, код 0, исполненных проверок
# 0. То есть всякая ветка уезжала отсюда НЕПРОВЕРЕННОЙ — не «зелёной».
#
# Починка состоит из двух половин, и каждая самостоятельна:
#   · адресат существует — этот файл, отслеживаемый, едет в каждый клон;
#   · отсутствие адресата ОТКАЗЫВАЕТ — переходник `v2` выходит ненулём.
# Разбор второй половины — в шапке scripts/hooks/install.sh.
#
# ─────────────────────────────────────────────────────────────────────────────
# ЧТО ГОНЯЕТСЯ ЗДЕСЬ — И ЧТО НЕ ГОНЯЕТСЯ
#
# Группы ниже — те задания конвейера (`.github/workflows/ci.yml`), которые
# исполнимы на машине разработчика: сборка · vet · vet под тегом integration ·
# gofmt · пробы `-short` · golangci-lint · audit-list-filter. Форма у них ТА ЖЕ,
# что в конвейере, и там, где рецепт уже объявляет цель, зовётся цель, а не
# инструмент напрямую: два разных способа спросить дают два законных вердикта об
# одном дереве, и спорить между ними нечем (`make lint`, kaname#54).
#
# НЕ гоняется здесь, и это названо, а не умолчано: интеграция на контейнерах ·
# сборка самостоятельного клона · `buf breaking` против ствола · сверка каталога
# прав и канона модели (требуют чекаут дерева платформы) · govulncheck и gosec
# (тянут инструмент из сети) · вердикт ствола (предмет — прогон конвейера).
# Перечень печатается в конце КАЖДОГО прогона: «хук зелен» обязано быть
# отличимо от «конвейер зелен».
#
# Стоимость измерена на этом дереве (ствол `cbbac984`, тёплый кэш сборки):
# сборка 17 с · vet 9 с · vet+integration 4 с · gofmt 1 с · пробы 57 с ·
# golangci-lint 13 с · audit-list-filter 0 с — около полутора минут.
#
# ─────────────────────────────────────────────────────────────────────────────
# КАК ОБОЙТИ И ПОЧЕМУ ЭТО ЗАКОННО
#
# `KANAME_SKIP_PREPUSH=1 git push` — обход нужен: отправка черновика ради
# обсуждения есть законное действие. Но он ЯВНЫЙ и печатает строку: обойти
# можно, не заметив — нельзя.
#
# Установка: `make install-hooks` — цель кладёт в `.git/hooks` переходник,
# исполняющий ЭТОТ файл из той рабочей копии, из которой идёт отправка.
# Проверить провязку в любой момент: `make check-hooks`.
set -uo pipefail

if [ "${KANAME_SKIP_PREPUSH:-0}" = "1" ]; then
    echo "pre-push: пропущен по KANAME_SKIP_PREPUSH=1 — локальные проверки НЕ выполнялись" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)" || {
    echo "pre-push: ОТКАЗ — корень рабочей копии не установлен, проверять нечего и негде" >&2
    exit 2
}

# ОКРУЖЕНИЕ GIT НЕ НАСЛЕДУЕТСЯ ПРОВЕРКАМИ. `git push` запускает хук с
# выставленным `GIT_DIR`, и дальше его наследует ВСЁ, что хук запускает, — в том
# числе `go test`.
#
# Цена не предположена, а измерена по этому дереву: файлов, заводящих
# синтетический репозиторий во временном каталоге (`git init` + `add`), — 16
# (`git grep -lE '"init"' -- '*_test.go' '*.go' | wc -l`). Пятнадцать из них
# берут окружение у `corelib/gitenv`, который GIT_* снимает сам; ОДИН остаётся на
# окружении процесса. С выставленным `GIT_DIR` git определяет репозиторий по
# переменной, а не по рабочему каталогу, — и `add` фикстуры пишет в индекс ЭТОЙ
# рабочей копии. Дальше ложь расходится кругами: проверки, читающие состав дерева
# через `git ls-files` (таких пакетов 7), видят чужой индекс и честно падают —
# отказ получают непричастные, а виновник остаётся невидимым.
#
# Поэтому хук — граница, на которой окружение обрывается. В конвейере класс не
# воспроизводится by construction: там проверки запускает не git.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH

cd "$ROOT" || exit 2

# ── ЧТО ИМЕННО УЕЗЖАЕТ — СПРАШИВАЕМ У GIT ───────────────────────────────────
#
# git передаёт хуку на вход строки `<local_ref> <local_sha> <remote_ref>
# <remote_sha>` — по одной на каждую отправляемую ссылку. Это авторитетный ответ
# на вопрос «что уедет этой отправкой»; имя текущей ветки его не заменяет.
#
# Пустой вход означает не «ничего не уезжает», а «хук позвали не отправкой»
# (руками, пробой). Эти два случая разведены: у первого проверять нечего, у
# второго — есть, и схлопывание их в один дало бы молчаливый пропуск при ручном
# прогоне.
refs_total=0
refs_live=0
refs_draft=0
zero='0000000000000000000000000000000000000000'
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    refs_total=$((refs_total + 1))
    [ "${local_sha:-$zero}" != "$zero" ] || continue
    case "$local_ref" in
        refs/heads/wip/*|refs/heads/tmp/*) refs_draft=$((refs_draft + 1)); continue ;;
    esac
    refs_live=$((refs_live + 1))
done

if [ "$refs_total" -gt 0 ] && [ "$refs_live" -eq 0 ]; then
    echo "pre-push: ссылок в отправке $refs_total · снимаемых $((refs_total - refs_draft - refs_live)) · черновиков $refs_draft · с новым содержимым 0" >&2
    echo "pre-push: проверять нечего — ни одна отправляемая ссылка не несёт нового содержимого" >&2
    exit 0
fi

# ── ГРУППЫ ──────────────────────────────────────────────────────────────────
#
# Каждая печатает СВОЙ исход одной из трёх категорий. Третья — «условие не
# создано»: инструмента нет на этой машине. Она не вычитается из вердикта и не
# зачитывается в успех, поэтому стоит в переписи своим числом.
#
# Четвёртая величина переписи — НЕ четвёртая категория: это оси, не спрошенные
# ВНУТРИ исполненной группы (метка `ОСЬ НЕ СПРОШЕНА`). Разбор — у самой метки.
#
# Метка третьей категории — ТА ЖЕ строка, что у целей рецепта и у гейта
# самостоятельного клона (`tools/standalonetargets`, UnmetPremiseMark). Второе
# написание сделало бы категорию беспредметной у того читателя, который о нём не
# знает, — молча.
unmet_mark='УСЛОВИЕ НЕ СОЗДАНО'

# ОСЬ, НЕ СПРОШЕННАЯ ВНУТРИ ИСПОЛНЕННОЙ ГРУППЫ, — ОТДЕЛЬНАЯ ВЕЛИЧИНА.
#
# Метка своя, и это исправление дефекта, найденного первым же боевым прогоном.
# Группа проб исполнила 8420 проб при нуле отказов и печатала при этом, что
# детектор гонок не гонялся (CGO_ENABLED=0). Классификатор читал ЛЮБУЮ метку
# третьей категории в выводе группы и записывал ВСЮ группу в «условие не
# создано»: перепись говорила «исполнено 6 из 7» там, где исполнено 7, а 8420
# проб не считались вовсе.
#
# То есть проверка, написанная против «код 0 при нуле исполненного», сама
# занижала число исполненного. Поэтому величин две: категория ГРУППЫ (её
# называет метка `unmet_mark` и код возврата) и перечень осей, не спрошенных
# внутри исполненной группы. Вторая не вычитается из первой и не прибавляется
# к ней — она печатается своим числом и своим списком.
axis_mark='ОСЬ НЕ СПРОШЕНА'

# need — инструмента нет на машине. Это ТРЕТЬЯ категория, а не находка: отчитаться
# о дереве отсутствием инструмента значило бы красить ствол чужой машиной.
# Возврат 2 сам по себе ничего не решает — категорию назначает метка в тексте.
need() {
    command -v "$1" >/dev/null 2>&1 && return 0
    echo "$unmet_mark (не находка): «$1» не найден в PATH — группа не исполнялась."
    return 2
}

group_build() { need go || return 2; go build ./...; }

group_vet() { need make || return 2; make vet; }

# Тег `integration` иначе не проверяется на собираемость НИ ОДНИМ шагом: пробы
# под ним гоняет только контейнерное задание, которого здесь нет.
group_vet_integration() { need go || return 2; go vet -tags=integration ./...; }

# gofmt по ИНДЕКСУ git, а не по диску: иначе в перепись попадут игнорируемые
# каталоги и кэши сборки. Пустой обход — отказ: «ноль неотформатированных» здесь
# означало бы «ноль прочитанного».
group_gofmt() {
    local files unformatted
    need gofmt || return 2
    files="$(git ls-files '*.go')"
    if [ -z "$files" ]; then
        echo "ОТКАЗ: обход пуст — ни одного файла Go не прочитано."
        return 1
    fi
    echo "прочитано файлов Go: $(printf '%s\n' "$files" | wc -l)"
    # shellcheck disable=SC2086
    unformatted="$(gofmt -l $files)" || return 1
    if [ -n "$unformatted" ]; then
        echo "требуется gofmt:"
        printf '%s\n' "$unformatted"
        return 1
    fi
    echo "неотформатированных нет."
}

# ПРОБЫ: вердикт выносит ПРОГОНЩИК, а не `go test`.
#
# Голый `go test` печатает `ok` и там, где пробы прошли, и там, где все
# пропущены, и там, где проб нет вовсе. Прогонщик `.github/scripts/go-test-verdict.py`
# отвечает числом: сколько пакетов осмотрено, сколько проб ИСПОЛНЕНО, сколько
# пропущено. Ровно этого числа не хватало прежнему переходнику.
#
# ДЕТЕКТОР ГОНОК — ОТДЕЛЬНАЯ ОСЬ, А НЕ МОЛЧАЛИВОЕ УПРОЩЕНИЕ. `-race` требует
# cgo; на машине без компилятора C `go test -race` отказывается стартовать
# ВООБЩЕ — обход пуст, проб исполнено ноль. Снять флаг молча значило бы
# подменить вердикт: пробы те же, а ось гонок не спрошена. Поэтому флаг
# ставится по ответу `go env CGO_ENABLED`, а его отсутствие печатается меткой
# `ОСЬ НЕ СПРОШЕНА` — своим числом в переписи. Группа при этом ИСПОЛНЕНА, и её
# 8420 проб идут в зачёт: неспрошенная ось не делает исполненное неисполненным.
group_probes() {
    local runner="$ROOT/.github/scripts/go-test-verdict.py" raw rc race=()
    need go || return 2
    if ! command -v python3 >/dev/null 2>&1; then
        echo "$unmet_mark (не находка): python3 не найден, а вердикт прогона выносит он."
        echo "  Без него у прогона нет числа исполненного, и «отказов 0» ничего не значит."
        return 2
    fi
    if [ ! -f "$runner" ]; then
        echo "$unmet_mark (не находка): прогонщик вердикта не найден: $runner"
        return 2
    fi
    if [ "$(go env CGO_ENABLED)" = "1" ]; then
        race=(-race)
    else
        echo "$axis_mark: детектор гонок — CGO_ENABLED=0, cgo на этой машине нет."
        echo "  Пробы ниже исполнены БЕЗ -race и в зачёт идут; ось гонок закрывает конвейер (задание unit)."
    fi
    raw="$(mktemp)" || return 2
    go test ./... "${race[@]}" -short -count=1 -timeout 25m -json > "$raw" 2>&1
    python3 "$runner" < "$raw"
    rc=$?
    rm -f "$raw"
    return "$rc"
}

group_lint() { need make || return 2; make lint; }

group_listfilter() { need make || return 2; make audit-list-filter; }

# Ведомость групп — ЕДИНСТВЕННЫЙ источник и перечня, и числа. Второй список дал
# бы «объявлено 7» при шести исполненных, и расхождение было бы невидимым.
groups=(
    "сборка|go build ./...|group_build"
    "vet|make vet|group_vet"
    "vet+integration|go vet -tags=integration ./...|group_vet_integration"
    "gofmt|gofmt по индексу git|group_gofmt"
    "пробы|go test ./... -short (вердикт прогонщиком)|group_probes"
    "lint|make lint (пин и конфигурация конвейера)|group_lint"
    "listfilter|make audit-list-filter|group_listfilter"
)

declared=0
green=0
red=0
unmet=0
red_names=()
unmet_names=()
axes_unmet=0
axes_names=()

for entry in "${groups[@]}"; do
    IFS='|' read -r gname gdesc gfunc <<< "$entry"
    declared=$((declared + 1))
    echo "── $gname: $gdesc" >&2
    out="$("$gfunc" 2>&1)"
    rc=$?
    # Третья категория опознаётся ТЕКСТОМ, а не кодом: `make` схлопывает любой
    # отказ рецепта в собственную двойку, поэтому «цель отказала» и «условия
    # нет» приходят до оболочки одним числом. Метка обязана стоять ПЕРВОЙ на
    # своей строке — иначе проза, объясняющая категорию, зеленела бы сама на
    # себе.
    # Оси, не спрошенные внутри группы, снимаются ДО классификации самой группы:
    # иначе строка о неспрошенной оси перевела бы в третью категорию всю группу.
    while IFS= read -r axis_line; do
        [ -n "$axis_line" ] || continue
        axes_unmet=$((axes_unmet + 1))
        axes_names+=("$gname: ${axis_line#*: }")
    done < <(printf '%s\n' "$out" | sed -n "s/^[[:space:]]*${axis_mark}//p")
    if printf '%s\n' "$out" | grep -qE "^[[:space:]]*${unmet_mark}"; then
        unmet=$((unmet + 1))
        unmet_names+=("$gname")
        printf '%s\n' "$out" >&2
        echo "   → условие не создано: вердикта о «$gname» НЕТ — ни зелёного, ни красного" >&2
        continue
    fi
    if [ "$rc" -ne 0 ]; then
        red=$((red + 1))
        red_names+=("$gname")
        printf '%s\n' "$out" >&2
        echo "   → КРАСНОЕ (код $rc)" >&2
        continue
    fi
    green=$((green + 1))
    printf '%s\n' "$out" | tail -12 >&2
    echo "   → зелёное" >&2
done

{
    echo
    echo "=== pre-push: перепись прогона ==="
    echo "ссылок в отправке   : $refs_total  (с новым содержимым $refs_live · черновиков $refs_draft)"
    echo "групп объявлено     : $declared"
    echo "групп ИСПОЛНЕНО     : $((green + red))  (зелёных $green · красных $red)"
    echo "условие не создано  : $unmet  (в зачёт прохода НЕ идёт)"
    echo "осей не спрошено    : $axes_unmet  (внутри ИСПОЛНЕННЫХ групп; из вердикта не вычитается)"
    [ "${#red_names[@]}" -eq 0 ] || echo "красные             : ${red_names[*]}"
    [ "${#unmet_names[@]}" -eq 0 ] || echo "без условия         : ${unmet_names[*]}"
    for a in ${axes_names[@]+"${axes_names[@]}"}; do echo "  ось не спрошена   : $a"; done
    echo
    echo "ЗДЕСЬ НЕ ГОНЯЛОСЬ (и потому «хук зелен» не значит «конвейер зелен»):"
    echo "  интеграция на контейнерах · самостоятельный клон · buf breaking против ствола ·"
    echo "  каталог прав и канон модели (нужен чекаут дерева платформы) · govulncheck · gosec ·"
    echo "  вердикт ствола"
} >&2

if [ "$red" -gt 0 ]; then
    echo "pre-push: ОТКАЗ — красных групп $red. Отправка остановлена." >&2
    echo "  Обход, если он осознан: KANAME_SKIP_PREPUSH=1 git push" >&2
    exit 1
fi

if [ "$((green + red))" -eq 0 ]; then
    echo "pre-push: ОТКАЗ — исполнено НОЛЬ групп из $declared." >&2
    echo "  Это не зелёное: «отказов 0» здесь означает «спросить было не у кого»." >&2
    exit 2
fi

echo "pre-push: зелёное — исполнено $green из $declared групп, отказов 0." >&2
exit 0
