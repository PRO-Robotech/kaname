#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Хук отправки: то, что можно узнать локально, узнаётся ДО конвейера.
#
# ─────────────────────────────────────────────────────────────────────────────
# ЗАЧЕМ ЭТОТ ФАЙЛ ВООБЩЕ ПОЯВИЛСЯ
#
# До него в клонах этого репозитория стоял переходник `.git/hooks/pre-push`,
# который искал ЭТОТ путь, не находил его — каталога `scripts/hooks` в дереве не
# было вовсе, — печатал «проверок НЕ БЫЛО» и выходил НУЛЁМ. Замер (2026-09-22,
# ствол `cbbac984`): отправка прошла за 1.3 секунды, код 0, исполненных проверок
# 0. То есть всякая ветка уезжала отсюда НЕПРОВЕРЕННОЙ — не «зелёной».
#
# Починка состоит из двух половин, и каждая самостоятельна:
#   · адресат существует — этот файл, отслеживаемый, едет в каждый клон;
#   · отсутствие адресата ОТКАЗЫВАЕТ — переходник `v2` выходит ненулём.
# Разбор второй половины — в шапке scripts/hooks/install.sh.
#
# ─────────────────────────────────────────────────────────────────────────────
# ЧТО ГОНЯЕТСЯ ЗДЕСЬ — И ЧТО НЕ ГОНЯЕТСЯ
#
# Группы ниже — те задания конвейера (`.github/workflows/ci.yml`), которые
# исполнимы на машине разработчика БЫСТРО: сборка · vet · vet под тегом
# integration · gofmt · пробы `-short` без детектора гонок · audit-list-filter.
# Форма у них ТА ЖЕ, что в конвейере, и там, где рецепт уже объявляет цель,
# зовётся цель, а не инструмент напрямую.
#
# НЕ гоняется здесь — перечень печатается на КАЖДОМ пути выхода, включая пути,
# на которых не исполнено ничего: `not_run_notice` ниже. Это не украшение:
# «хук зелен» и «конвейер зелен» обязаны быть различимы, а на пути обхода
# различать нечего вовсе, и сказать это надо там же.
#
# ─────────────────────────────────────────────────────────────────────────────
# БЮДЖЕТ ПАМЯТИ — ДЕРЖИТСЯ МЕХАНИЗМОМ, А НЕ ОЦЕНКОЙ
#
# Хук исполняется на каждой отправке, на машине, где параллельно идут другие
# полосы. Решение владельца 2026-09-24: память машины не переваливает за 45 ГБ,
# тяжёлое локально не гоняется — его гоняет конвейер на АГРЕГАТЕ волны. Прежняя
# редакция звала `go test ./... -race` с параллелизмом по числу ядер и
# `make lint` без всякого потолка. Отсюда три свойства:
#
#   · детектор гонок и golangci-lint здесь НЕ гоняются — они в перечне
#     непроверенного, их вердикт выносит конвейер;
#   · параллелизм Go — 4 (`GOFLAGS` дополняется `-p=4` последним, поэтому
#     перекрывает любое прежнее `-p`);
#   · весь прогон идёт под потолком памяти 10 ГБ без подкачки — хук
#     перезапускает себя в области `systemd-run --user --scope`. Машина, где
#     области не выставить, прогон не теряет: отсутствие потолка печатается
#     строкой, а не умалчивается.
#
# Держит это опыт `scripts/hooks/prepush-budget-inject.sh`, который гоняет
# настоящий хук с записывающими `go` и `systemd-run` и зовётся конвейером.
#
# ─────────────────────────────────────────────────────────────────────────────
# СКОЛЬКО ЭТО СТОИТ — И КОМУ
#
# Единица цены — прогон хука ЦЕЛИКОМ, потому что платит за него человек,
# нажавший `git push`. Предикат: `printf '' | bash scripts/hooks/pre-push`.
#
# Замер 2026-09-24 на дереве правки бюджета (родитель `ce94980f5` — ветка 358
# со сведённой работой #349), `CGO_ENABLED=0`, параллелизм Go 4, потолок 10 ГБ:
# 170 с, код 0, групп 6 из 6,
# при средней загрузке 6-9 (параллельно шли другие полосы). Рабочая копия была
# свежей, кэш сборки машины — общий и прогретый. Прогон уложился в потолок:
# область systemd его не остановила.
#
# АБСОЛЮТНОЕ ЧИСЛО СЕКУНД НЕ ВОСПРОИЗВОДИТСЯ — оно зависит от загрузки машины,
# и читатель, сверяющий цену, обязан назвать загрузку, при которой мерил.
# Прежняя редакция стоила 48…144 с (`cecdf435`, 2026-09-22) — с `-race`, линтером
# и параллелизмом по числу ядер; разница — плата за бюджет памяти, и она
# принята решением владельца, а не недосмотром.
#
# ─────────────────────────────────────────────────────────────────────────────
# ЧИСЛО ИСПОЛНЕННЫХ ПРОБ — СВОЙСТВО КЛОНА, А НЕ ДЕРЕВА
#
# Единица счёта — СОБЫТИЕ ПРОБЫ, подпробы считаются; так её и называет прогонщик
# `.github/scripts/go-test-verdict.py`.
#
# Замер 2026-09-24 там же: 169 пакетов, 9235 исполненных при 1656
# пропущенных. Замер 2026-09-22 на `cecdf435` показал, что число зависит от
# СОСТОЯНИЯ КЛОНА: в рабочей копии 8420 при 1552, в свежем клоне того же коммита
# 8419 при 1553, сумма та же — проба ПЕРЕЕЗЖАЕТ из исполненных в пропущенные.
# Переезжала ровно одна — `internal/check`,
# `TestMODRD23MigrationDoesNotWriteARoleOfAManifestBearingModule`: ей нужен
# разрешимый `origin/main`, чтобы установить состав ДОБАВЛЕННОГО, а без него она
# объявляет «условие не создано». Проверено в обе стороны: заведи ссылку в
# свежем клоне — проба исполняется; сними — пропускается.
#
# Значит расхождение в одно событие относится к СОСТОЯНИЮ КЛОНА, а не к дереву.
# Прежняя редакция привязывала число к ревизии («ствол `cbbac984`»), и привязка
# неверна: между `cbbac984` и `cecdf435` изменённых файлов Go — 0.
#
# ─────────────────────────────────────────────────────────────────────────────
# ЧТО ЭТОТ ХУК СУДИТ — И ЧЕГО ОН ПОКА НЕ СУДИТ
#
# Он судит РАБОЧУЮ КОПИЮ, а уезжает КОММИТ. Совпадают они у всякого, кто
# отправляет то, что только что написал, и расходятся у того, кто отправляет
# старую ветку из грязного дерева: тогда проверено не то, что поедет.
#
# Названо здесь, а не умолчано, потому что тихая неполнота — это ровно тот
# класс, ради которого файл написан. Закрывается отдельным производителем
# диапазона (git подаёт хуку `<local_ref> <local_sha> <remote_ref>
# <remote_sha>`); так сделано в соседнем репозитории —
# `kacho:scripts/hooks/prepush-range.sh`. Здесь этого ещё нет.
#
# ─────────────────────────────────────────────────────────────────────────────
# КАК ОБОЙТИ — ПЕРЕЧЕНЬ ПОЛНЫЙ, И ЭТО ЕГО СВОЙСТВО
#
# Обход ОДИН: `KANAME_SKIP_PREPUSH=1 git push`. Он печатает строку и перечень
# непроверенного — обойти, не заметив, нельзя. Снимает он только ПРОВЕРКИ:
# страж правила ветки и коммита (scripts/hooks/prepush-rule.sh) идёт первым и
# обходом не снимается — это держит проба scripts/hooks/branch-rule-inject.sh.
#
# Обхода ПО ИМЕНИ ВЕТКИ здесь НЕТ, и это снято намеренно. Прежняя редакция
# пропускала `wip/*` и `tmp/*`, не называя этого в перечне обходов, а причиной
# печатала «ни одна ссылка не несёт нового содержимого» — утверждение ложное:
# ссылка на назначении создавалась, со всем деревом. Необъявленный обход — тот
# же класс, ради которого написан весь файл, и заведён он был по аналогии с
# соседним репозиторием, а не по измеренной нужде.
#
# `git push --no-verify` обходит хук средствами git, до его запуска; сказать о
# себе отсюда он не может by construction, и потому в перечень обходов ЭТОГО
# файла не входит — он в перечне корпуса (`git-issues.md`: только по явной
# просьбе владельца).
#
# Установка: `make install-hooks`. Проверить провязку: `make check-hooks`.
set -uo pipefail

# ── ЧТО НЕ ГОНЯЛОСЬ — НА КАЖДОМ ПУТИ ВЫХОДА ─────────────────────────────────
#
# executed — сколько групп ИСПОЛНЕНО к моменту выхода. На путях обхода это ноль,
# и печатается он тем же числом: ноль исполненного обязан выглядеть как ноль
# исполненного, а не как отсутствие строки.
executed=0

not_run_notice() {
    {
        echo
        echo "pre-push: исполнено групп проверок: $executed"
        echo "ЗДЕСЬ НЕ ГОНЯЛОСЬ (и потому «хук зелен» не значит «конвейер зелен»):"
        echo "  детектор гонок (-race) · golangci-lint (make lint) — тяжёлое, на агрегате конвейером ·"
        echo "  интеграция на контейнерах · самостоятельный клон · buf breaking против ствола ·"
        echo "  каталог прав и канон модели (нужен чекаут дерева платформы) · govulncheck · gosec ·"
        echo "  вердикт ствола"
    } >&2
}

# finish — единственный выход из этого файла. Любой `exit` мимо него оставил бы
# путь, на котором перечень непроверенного не печатается, — а это ровно те пути,
# где не проверено ничего.
finish() {
    local code="$1"; shift
    not_run_notice
    printf '%s\n' "$@" >&2
    exit "$code"
}

# ── ПОТОЛОК ПАМЯТИ ──────────────────────────────────────────────────────────
#
# Хук перезапускает себя в области systemd с потолком 10 ГБ без подкачки
# (разбор — в шапке, «БЮДЖЕТ ПАМЯТИ»). Область передаёт окружение, stdin с
# перечнем ссылок и код возврата насквозь — это держит ось 3 опыта бюджета.
#
# Повторный запуск опознаётся ДОВОДОМ, а не переменной окружения: переменную
# наследовал бы всякий вложенный процесс и мог бы выставить кто угодно, и тогда
# потолок снимался бы молча. Довод видит только этот файл, и git под таким
# именем удалённого хуку ничего не подаёт.
#
# Где области не выставить (нет systemd-run, нет пользовательского systemd —
# так бывает в контейнере конвейера), прогон НЕ теряется: причина печатается
# строкой в переписи. Потолок здесь — защита машины, а не вердикт о дереве.
SCOPE_ARG='--kaname-prepush-in-memory-scope'
MEMORY_MAX='10G'
memory_cap=""
if [ "${1:-}" = "$SCOPE_ARG" ]; then
    shift
    memory_cap="MemoryMax=$MEMORY_MAX, MemorySwapMax=0 (systemd-run --user --scope)"
elif ! command -v systemd-run >/dev/null 2>&1; then
    memory_cap="потолок памяти не выставлен: systemd-run не найден в PATH"
elif ! systemd-run --user --scope --quiet -p MemoryMax="$MEMORY_MAX" -p MemorySwapMax=0 -- true </dev/null >/dev/null 2>&1; then
    memory_cap="потолок памяти не выставлен: systemd-run --user --scope отказал (нет пользовательского systemd?)"
else
    exec systemd-run --user --scope --quiet -p MemoryMax="$MEMORY_MAX" -p MemorySwapMax=0 -- \
        bash "$0" "$SCOPE_ARG" "$@"
fi
echo "pre-push: память — $memory_cap" >&2

ROOT="$(git rev-parse --show-toplevel)" || ROOT=""
if [ -z "$ROOT" ]; then
    finish 2 "pre-push: ОТКАЗ — корень рабочей копии не установлен: проверять нечего и негде." \
             "  Это не «нечего проверять», а «спросить не у кого»."
fi

# ОКРУЖЕНИЕ GIT НЕ НАСЛЕДУЕТСЯ ПРОВЕРКАМИ. `git push` запускает хук с
# выставленным `GIT_DIR`, и дальше его наследует ВСЁ, что хук запускает, — в том
# числе `go test`.
#
# Цена не предположена, а измерена по этому дереву: файлов, заводящих
# синтетический репозиторий во временном каталоге (`git init` + `add`), — 16
# (`git grep -lE '"init"' -- '*_test.go' '*.go' | wc -l`). Пятнадцать из них
# берут окружение у `corelib/gitenv`, который GIT_* снимает сам; ОДИН остаётся на
# окружении процесса. С выставленным `GIT_DIR` git определяет репозиторий по
# переменной, а не по рабочему каталогу, — и `add` фикстуры пишет в индекс ЭТОЙ
# рабочей копии. Дальше ложь расходится кругами: проверки, читающие состав дерева
# через `git ls-files` (таких пакетов 7), видят чужой индекс и честно падают —
# отказ получают непричастные, а виновник остаётся невидимым.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_QUARANTINE_PATH

# Параллелизм Go — 4 на весь прогон (сборка, vet, пробы). Дописывается ПОСЛЕДНИМ:
# из двух `-p` в GOFLAGS действует последнее, а доводы командной строки хук не
# ставит, значит прежнее значение человека перекрыто, а не проигнорировано.
GO_PARALLEL=4
export GOFLAGS="${GOFLAGS:+$GOFLAGS }-p=$GO_PARALLEL"

cd "$ROOT" || finish 2 "pre-push: ОТКАЗ — в корень рабочей копии не перейти: $ROOT"

# Вход git читается ОДИН раз: его судят и страж правила, и перепись ссылок ниже.
push_input="$(cat)"

# ── СТРАЖ ПРАВИЛА ВЕТКИ И КОММИТА — ПЕРВЫМ, ДО ОБХОДА ПРОВЕРОК ──────────────
#
# Имя ветки, первая строка, подпись и атрибуция отправляемых коммитов
# (scripts/hooks/prepush-rule.sh, предикат — branch-rule.sh). Обход проверок
# `KANAME_SKIP_PREPUSH=1` стоит ПОСЛЕ стража и его не снимает: обход заведён для
# проверок, цена которых — время, а у правила ветки цены нет. Нет стража —
# отказ: хук без него пропускал бы нарушение молча.
rule_guard="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/prepush-rule.sh"
if [ ! -f "$rule_guard" ]; then
    finish 1 "pre-push ОТКАЗ: нет $rule_guard — правило ветки и коммита судить нечем"
fi
rule_out="$(bash "$rule_guard" "${1:-origin}" <<< "$push_input" 2>&1)"
rule_rc=$?
printf '%s\n' "$rule_out" >&2
if [ "$rule_rc" -eq 2 ]; then
    finish 2 "pre-push: НЕ ВЫПОЛНИЛОСЬ — страж правила ветки и коммита не смог судить; отправка остановлена"
fi
if [ "$rule_rc" -ne 0 ]; then
    finish 1 "pre-push ОТКАЗ: правило ветки и коммита нарушено — отправка остановлена"
fi

if [ "${KANAME_SKIP_PREPUSH:-0}" = "1" ]; then
    finish 0 "pre-push: проверки пропущены по KANAME_SKIP_PREPUSH=1 — страж правила исполнен, локальные проверки НЕ выполнялись"
fi

CLASSIFY="$ROOT/scripts/hooks/prepush-classify.sh"
[ -x "$CLASSIFY" ] || finish 2 \
    "pre-push: ОТКАЗ — не найден определитель категории: $CLASSIFY" \
    "  Без него исход группы пришлось бы выводить из её вывода — ровно тем способом," \
    "  которым упавшая проба однажды обнулила собственную красноту."

# ── ЧТО ИМЕННО УЕЗЖАЕТ ──────────────────────────────────────────────────────
#
# git подаёт на вход строки `<local_ref> <local_sha> <remote_ref> <remote_sha>`.
# Пустой вход означает не «ничего не уезжает», а «хук позвали не отправкой»
# (руками, пробой): у первого проверять нечего, у второго — есть.
#
# СНЯТИЕ ССЫЛКИ И ЧЕРНОВИК — РАЗНЫЕ ВЕЩИ, И ВТОРОГО ЗДЕСЬ НЕТ. Снятие (`local_sha`
# из нулей) не везёт содержимого by construction: проверять в нём нечего, и это
# утверждение проверяемо. Пропуск по ИМЕНИ ветки содержимое везёт — он был бы
# обходом, и его здесь не заведено (разбор в перечне обходов выше).
refs_total=0
refs_live=0
refs_delete=0
zero='0000000000000000000000000000000000000000'
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    refs_total=$((refs_total + 1))
    if [ "${local_sha:-$zero}" = "$zero" ]; then
        refs_delete=$((refs_delete + 1))
        continue
    fi
    refs_live=$((refs_live + 1))
done <<< "$push_input"

if [ "$refs_total" -gt 0 ] && [ "$refs_live" -eq 0 ]; then
    finish 0 \
        "pre-push: ссылок в отправке $refs_total, из них СНИМАЮТСЯ $refs_delete, с содержимым 0" \
        "pre-push: содержимого не уезжает — проверять нечего"
fi

# ── ПРОГОН СЕРИАЛИЗОВАН ─────────────────────────────────────────────────────
#
# Два прогона хука в ОДНОЙ рабочей копии удвоили бы потребление памяти и делили
# бы её каталог `.cache`; второй ждёт первого, а не состязается с ним.
mkdir -p "$ROOT/.cache" 2>/dev/null || true
LOCK="$ROOT/.cache/prepush.lock"
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK" || finish 2 "pre-push: ОТКАЗ — не открыть файл замка $LOCK"
    if ! flock -w 900 9; then
        finish 2 \
            "pre-push: НЕ ВЫПОЛНИЛОСЬ — в этой рабочей копии уже идёт прогон хука, замок не взят за 900 с." \
            "  Это не красное и не зелёное: проверки не исполнялись."
    fi
fi

# ── ГРУППЫ ──────────────────────────────────────────────────────────────────
#
# КАТЕГОРИЮ ГРУППЫ ОПРЕДЕЛЯЕТ НЕ ТЕКСТ. Прежняя редакция читала вывод группы и
# переводила в третью категорию всякую, где встречалась метка «УСЛОВИЕ НЕ
# СОЗДАНО» в начале строки. Вывод группы — это вывод чужих программ: прогонщик
# проб печатает текст отказа упавшей пробы, поэтому проба, чей текст несёт эту
# метку, ОБНУЛЯЛА свою красноту, а хук печатал «зелёное» и пропускал отправку.
# Воспроизведено на боевом хуке 2026-09-22.
#
# Теперь сигналов два, и оба производит сам хук: код возврата группы и файл
# заявки, в который пишет ТОЛЬКО `declare_unmet`. Сводит их
# `scripts/hooks/prepush-classify.sh`, которому вывод группы не передаётся
# вовсе; расхождение сигналов — отдельный исход, а не выбор одного. Держит тут
# именно СОГЛАСИЕ двух сигналов, а не недосягаемость файла заявки: разбор с
# числами опыта — в шапке определителя.
#
# Метку по-прежнему ПЕЧАТАЮТ (словарь дерева один), но её больше не ЧИТАЮТ.

# UNMET_RC обязан совпадать с тем, что знает определитель. Совпадение проверяет
# инъекция определителя, а не внимание.
UNMET_RC=3

# UNMET_FILE и AXIS_FILE НЕ ЭКСПОРТИРУЮТСЯ, и вложенный процесс их путей не
# наследует — это измерено (0 переменных из 72 в снимке окружения). Но
# неподделываемости это НЕ даёт: файлы лежат во временном каталоге того же
# пользователя и находятся перебором по образцу — измерено там же, 7 найденных
# файлов и 21 успешная запись. Подделку останавливает согласие сигналов, а не
# недосягаемость файла; разбор — в шапке `prepush-classify.sh`.
UNMET_FILE=""
AXIS_FILE=""

unmet_mark='УСЛОВИЕ НЕ СОЗДАНО'
axis_mark='ОСЬ НЕ СПРОШЕНА'

# declare_unmet — «группа НЕ исполнялась, и вот предпосылка». Единственный
# способ попасть в третью категорию. Зовущий обязан тут же вернуть $UNMET_RC.
declare_unmet() {
    printf '%s\n' "$1" >> "$UNMET_FILE"
    echo "$unmet_mark (не находка): $1"
}

# declare_axis — ось, не спрошенная ВНУТРИ исполненной группы. Из вердикта не
# вычитается и в него не зачитывается: у неё своё число в переписи.
declare_axis() {
    printf '%s\n' "$1" >> "$AXIS_FILE"
    echo "$axis_mark: $1"
}

need() {
    command -v "$1" >/dev/null 2>&1 && return 0
    declare_unmet "«$1» не найден в PATH — группа не исполнялась"
    return "$UNMET_RC"
}

group_build() { need go || return "$UNMET_RC"; go build ./...; }

group_vet() { need make || return "$UNMET_RC"; make vet; }

# Тег `integration` иначе не проверяется на собираемость НИ ОДНИМ шагом: пробы
# под ним гоняет только контейнерное задание, которого здесь нет.
group_vet_integration() { need go || return "$UNMET_RC"; go vet -tags=integration ./...; }

# gofmt по ИНДЕКСУ git, а не по диску: иначе в перепись попадут игнорируемые
# каталоги и кэши сборки. Пустой обход — отказ: «ноль неотформатированных» здесь
# означало бы «ноль прочитанного».
group_gofmt() {
    local files unformatted
    need gofmt || return "$UNMET_RC"
    files="$(git ls-files '*.go')"
    if [ -z "$files" ]; then
        echo "ОТКАЗ: обход пуст — ни одного файла Go не прочитано."
        return 1
    fi
    echo "прочитано файлов Go: $(printf '%s\n' "$files" | wc -l)"
    # shellcheck disable=SC2086
    unformatted="$(gofmt -l $files)" || return 1
    if [ -n "$unformatted" ]; then
        echo "требуется gofmt:"
        printf '%s\n' "$unformatted"
        return 1
    fi
    echo "неотформатированных нет."
}

# ПРОБЫ: вердикт выносит ПРОГОНЩИК, а не `go test`. Голый `go test` печатает `ok`
# и там, где пробы прошли, и там, где все пропущены, и там, где проб нет вовсе.
#
# ДЕТЕКТОР ГОНОК ЗДЕСЬ НЕ ГОНЯЕТСЯ. `-race` умножает память каждого бинаря проб
# в разы и требует cgo; по решению владельца 2026-09-24 он — на агрегате
# конвейером (разбор бюджета — в шапке). Перечень непроверенного называет его на
# каждом пути выхода. Параллелизм — из `GOFLAGS`, выставленного выше.
group_probes() {
    local runner="$ROOT/.github/scripts/go-test-verdict.py" raw rc
    need go || return "$UNMET_RC"
    need python3 || return "$UNMET_RC"
    if [ ! -f "$runner" ]; then
        declare_unmet "прогонщик вердикта не найден: $runner — без него у прогона нет числа исполненного"
        return "$UNMET_RC"
    fi
    raw="$(mktemp)" || { declare_unmet "временный файл не создан"; return "$UNMET_RC"; }
    go test ./... -short -count=1 -timeout 25m -json > "$raw" 2>&1
    python3 "$runner" < "$raw"
    rc=$?
    rm -f "$raw"
    return "$rc"
}

group_listfilter() { need make || return "$UNMET_RC"; make audit-list-filter; }

# Ведомость групп — ЕДИНСТВЕННЫЙ источник и перечня, и числа.
groups=(
    "сборка|go build ./...|group_build"
    "vet|make vet|group_vet"
    "vet+integration|go vet -tags=integration ./...|group_vet_integration"
    "gofmt|gofmt по индексу git|group_gofmt"
    "пробы|go test ./... -short (вердикт прогонщиком)|group_probes"
    "listfilter|make audit-list-filter|group_listfilter"
)

declared=0
green=0
red=0
unmet=0
undecided=0
red_names=()
unmet_names=()
undecided_names=()
axes_names=()

scratch="$(mktemp -d)" || finish 2 "pre-push: ОТКАЗ — временный каталог не создан, судить не в чем"
trap 'rm -rf "$scratch"' EXIT

# ВРЕМЕННЫЙ КАТАЛОГ ВНУТРИ СУДИМОГО ДЕРЕВА — ТРЕТЬЯ КАТЕГОРИЯ, А НЕ КРАСНОЕ.
#
# `mktemp` берёт корень из TMPDIR, а TMPDIR хук НАСЛЕДУЕТ у того, кто позвал
# `git push`. Значит без этой проверки место, где лежат сигнальные файлы хука
# (`unmet.N`, `axis.N`) и промежуточный вывод прогонщика проб, назначает
# окружение — и оно может назначить его ВНУТРИ того самого дерева, о котором
# хук выносит вердикт.
#
# Вред измерен на этом дереве (2026-09-22, `cecdf435`) парой прогонов одного
# коммита, отличающихся ТОЛЬКО значением TMPDIR:
#   · TMPDIR снаружи — групп ИСПОЛНЕНО 7 (зелёных 7 · красных 0), код 0;
#   · TMPDIR внутри  — групп ИСПОЛНЕНО 7 (зелёных 6 · красных 1), код 1.
# СКОЛЬКО ИМЕННО ПРОБ ПАДАЕТ — НЕ ФАКТ О ДЕРЕВЕ. Число считает обходчиков,
# заставших каталог сборки Go живым, то есть зависит от загрузки так же, как
# секунды прогона; оно названо ниже с разбросом и загрузкой.
#
# Вердикт стал бы функцией окружения, а красное — ложным: оно сообщало бы о
# дереве, тогда как о дереве ничего не сказано. Поэтому исход здесь ТРЕТИЙ.
#
# ШИРИНА У СТРАЖА ВЕРНА, А ПРИЧИН У НЕЁ ДВЕ, И ОБЕ ИЗМЕРЕНЫ.
#
# Форма досталась от проб рядом вместе с их вопросом «а не внутри ли ВСЯКОГО
# репозитория», и ширина эта выглядела чрезмерной: вред хук объявлял только для
# СУДИМОГО дерева. Опыт показал обратное — вред есть и от постороннего:
#
#   1. ВНУТРИ СУДИМОГО ДЕРЕВА. Каталоги сборки Go заводятся и снимаются по ходу
#      прогона, обходчики дерева видят их и честно падают. Пять замеров дали
#      9 · 11 · 12 · 12 · 14 упавших проб (у четырёх записана средняя загрузка,
#      9-20); текст отказа — «обход дерева службы не выполнен: lstat
#      ../../../../tmp-inside/go-build…/b972: no such file or directory».
#      Здесь стояло «упало 14 проб» как факт о дереве — это было неверно.
#   2. ВНУТРИ ЛЮБОГО РЕПОЗИТОРИЯ, включая посторонний. Пробы, строящие
#      синтетический корень во временном каталоге, при обходе вверх получают
#      ЧУЖОЙ индекс — тот самый довод, которым ширина обоснована в обеих
#      пробах. Воспроизведено дважды из двух на постороннем репозитории:
#      `internal/manifest :: TestCheckTreeRefusesLoudlyWhenTheRootHasNoIndex`
#      даёт «корень без индекса дал код 2, ожидалась находка (1)».
#
# Поэтому отказывают обе ветви, но причина называется РАЗНАЯ: читателю нужно
# знать, чем именно ему вредит его TMPDIR.
#
# И СПРАШИВАЕТСЯ ФИЗИЧЕСКИЙ ПУТЬ, А НЕ ЗАПИСЬ ПУТИ. Подъём по `dirname` идёт по
# тексту, поэтому TMPDIR, заданный символьной ссылкой внутрь дерева, страж
# пропускал молча: измерено — все 7 заголовков групп напечатаны и хук пошёл
# считать. Дыра была общей у хука и у обеих проб, потому что форму копировали
# вместе с нею; закрыта она во всех трёх.
resolve_dir() { ( cd "$1" 2>/dev/null && pwd -P ); }
scratch_real="$(resolve_dir "$scratch")"
root_real="$(resolve_dir "$ROOT")"
if [ -z "$scratch_real" ] || [ -z "$root_real" ]; then
    finish 2 "pre-push: НЕ ВЫПОЛНИЛОСЬ — физический путь не установлен: каталог прогона «$scratch», корень «$ROOT»."
fi

probe_dir="$scratch_real"
enclosing=""
while :; do
    if [ -e "$probe_dir/.git" ]; then enclosing="$probe_dir"; break; fi
    parent="$(dirname "$probe_dir")"
    [ "$parent" != "$probe_dir" ] || break
    probe_dir="$parent"
done

if [ -n "$enclosing" ] && [ "$enclosing" = "$root_real" ]; then
    finish 2 \
        "pre-push: НЕ ВЫПОЛНИЛОСЬ — временный каталог лежит ВНУТРИ СУДИМОГО дерева." \
        "  Каталог прогона: $scratch_real" \
        "  Судимое дерево : $root_real  (корень временного берётся из TMPDIR=${TMPDIR:-/tmp})" \
        "  Обходчики дерева увидели бы в нём каталоги сборки Go и упали бы, сообщая о ДЕРЕВЕ" \
        "  то, чего дерево не совершало. Это не красное и не зелёное: проверки не исполнялись." \
        "  Назовите TMPDIR вне всякого репозитория и повторите отправку."
fi
if [ -n "$enclosing" ]; then
    finish 2 \
        "pre-push: НЕ ВЫПОЛНИЛОСЬ — временный каталог лежит внутри ПОСТОРОННЕГО репозитория." \
        "  Каталог прогона: $scratch_real" \
        "  Репозиторий    : $enclosing  (корень временного берётся из TMPDIR=${TMPDIR:-/tmp})" \
        "  Пробы, строящие синтетический корень во временном каталоге, получили бы при обходе" \
        "  вверх ЧУЖОЙ индекс и судили бы не свой предмет. Это не красное и не зелёное." \
        "  Назовите TMPDIR вне всякого репозитория и повторите отправку."
fi

for entry in "${groups[@]}"; do
    IFS='|' read -r gname gdesc gfunc <<< "$entry"
    declared=$((declared + 1))
    echo "── $gname: $gdesc" >&2

    UNMET_FILE="$scratch/unmet.$declared"
    AXIS_FILE="$scratch/axis.$declared"
    : > "$UNMET_FILE"
    : > "$AXIS_FILE"

    out="$("$gfunc" 2>&1)"
    rc=$?

    verdict="$("$CLASSIFY" --rc "$rc" --unmet "$UNMET_FILE" 2>"$scratch/cerr.$declared")"
    crc=$?

    while IFS= read -r axis_line; do
        [ -n "$axis_line" ] || continue
        axes_names+=("$gname: $axis_line")
    done < "$AXIS_FILE"

    if [ "$crc" -ne 0 ]; then
        undecided=$((undecided + 1))
        undecided_names+=("$gname")
        printf '%s\n' "$out" >&2
        cat "$scratch/cerr.$declared" >&2
        echo "   → НЕ ВЫПОЛНИЛОСЬ: категория «$gname» не установлена" >&2
        continue
    fi

    case "$verdict" in
    unmet)
        unmet=$((unmet + 1))
        unmet_names+=("$gname")
        printf '%s\n' "$out" >&2
        echo "   → условие не создано: вердикта о «$gname» НЕТ — ни зелёного, ни красного" >&2
        ;;
    red)
        red=$((red + 1))
        red_names+=("$gname")
        printf '%s\n' "$out" >&2
        echo "   → КРАСНОЕ (код $rc)" >&2
        ;;
    green)
        green=$((green + 1))
        printf '%s\n' "$out" | tail -12 >&2
        echo "   → зелёное" >&2
        ;;
    *)
        undecided=$((undecided + 1))
        undecided_names+=("$gname")
        echo "   → НЕ ВЫПОЛНИЛОСЬ: определитель ответил «$verdict»" >&2
        ;;
    esac
done
executed=$((green + red))

{
    echo
    echo "=== pre-push: перепись прогона ==="
    echo "ссылок в отправке   : $refs_total  (с содержимым $refs_live · снимаемых $refs_delete)"
    echo "групп объявлено     : $declared"
    echo "групп ИСПОЛНЕНО     : $executed  (зелёных $green · красных $red)"
    echo "условие не создано  : $unmet  (в зачёт прохода НЕ идёт)"
    echo "категория не установлена: $undecided  (дефект хука, не исход группы)"
    echo "осей не спрошено    : ${#axes_names[@]}  (внутри ИСПОЛНЕННЫХ групп; из вердикта не вычитается)"
    echo "память              : $memory_cap · параллелизм Go $GO_PARALLEL"
    [ "${#red_names[@]}" -eq 0 ] || echo "красные             : ${red_names[*]}"
    [ "${#unmet_names[@]}" -eq 0 ] || echo "без условия         : ${unmet_names[*]}"
    [ "${#undecided_names[@]}" -eq 0 ] || echo "без категории       : ${undecided_names[*]}"
    for a in ${axes_names[@]+"${axes_names[@]}"}; do echo "  ось не спрошена   : $a"; done
} >&2

if [ "$undecided" -gt 0 ]; then
    finish 2 "pre-push: НЕ ВЫПОЛНИЛОСЬ — у $undecided групп категория не установлена. Отправка остановлена."
fi
if [ "$red" -gt 0 ]; then
    finish 1 "pre-push: ОТКАЗ — красных групп $red. Отправка остановлена." \
             "  Обход, если он осознан: KANAME_SKIP_PREPUSH=1 git push"
fi
if [ "$executed" -eq 0 ]; then
    finish 2 "pre-push: ОТКАЗ — исполнено НОЛЬ групп из $declared." \
             "  Это не зелёное: «отказов 0» здесь означает «спросить было не у кого»."
fi
finish 0 "pre-push: зелёное — исполнено $executed из $declared групп, отказов 0."
