#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Хук отправки kaname: то, что можно узнать локально, узнаётся ДО конвейера.
#
# ЗАЧЕМ ОН ЗАВЕДЁН. Его не было вовсе. Переходник в `.git/hooks/pre-push`
# печатал «в этой рабочей копии нет …/scripts/hooks/pre-push — проверок НЕ БЫЛО»
# и выходил НУЛЁМ, поэтому тринадцать коммитов уехали 2026-09-22 без единой
# локальной проверки, и ни одна из них не была обойдена: обходить было нечего.
# Класс тот же, что вычищался в этот день из четырёх приборов подряд — исход
# берётся из канала, у которого нет предмета, а объём осмотренного не печатается.
# Предмет: PRO-Robotech/kaname#349.
#
# ОСНОВНОЕ СВОЙСТВО — FAIL-CLOSED. Отсутствие проверок здесь ОТКАЗ, а не успех,
# и «проверок не было» отличается от «проверки прошли» КОДОМ ВОЗВРАТА:
#
#   0 — все объявленные проверки исполнены, отказов нет;
#   1 — исполнены, и есть отказ по существу (находка в дереве);
#   3 — есть объявленная проверка, которая НЕ ИСПОЛНИЛАСЬ (прибор не запустился);
#   4 — хук не смог установить, что уезжает (диапазон отправки не построен).
#
# Коды 3 и 4 — не «красное»: находок нет ни одной, потому что не смотрели. Оба
# останавливают отправку, и это ровно та разница, ради которой хук написан.
#
# ДВЕ ФОРМЫ НУЛЯ РАЗЛИЧАЮТСЯ СЛОВОМ, А НЕ ИНТОНАЦИЕЙ:
#
#   «ПРЕДМЕТА НЕТ»        — проверять нечего: отправка несёт только удаление
#                           ссылок, ни одного коммита наружу не едет. Код 0;
#   «ПРИБОР НЕ ЗАПУСТИЛСЯ» — проверок не было, потому что объявленная проверка
#                           не исполнилась. Код 3. Это ОТКАЗ.
#
# ВЕРДИКТ БЕРЁТСЯ ТАМ, ГДЕ ПРОИЗВЕДЁН. Обёртки здесь нет намеренно. У соседнего
# дерева вердикт собирает `scripts/ci-local.sh`, и 2026-09-22 измерено, что её
# код возврата разошёлся с исходом операции в 3 отправках из 8. Поэтому каждая
# проверка здесь запускается САМА, её код читается из `$?` сразу за её
# процессом — без трубы, без `tee`, без шага после неё, — и в переписи стоит
# рядом с её именем.
#
# КАК ОБОЙТИ. Только `git push --no-verify`. Второй двери — переменной окружения,
# пропуска по имени ветки — у этого хука НЕТ, и это решение: каждая такая дверь
# есть ещё один путь напечатать ноль как успех. Обход `--no-verify` по правилу
# корпуса выдаётся явной просьбой владельца (gi-no-verify-by-request).
#
# РЕЖИМЫ ДЛЯ ЧЕЛОВЕКА (проверок не гоняют, отправку не трогают):
#   scripts/hooks/pre-push --boundary   — напечатать границу: что НЕ проверяется;
#   scripts/hooks/pre-push --roster     — напечатать объявленный набор;
#   scripts/hooks/pre-push --wiring     — сказать, провязан ли хук в этот клон;
#   scripts/hooks/pre-push --self-test  — доказать ОПЫТОМ, что коды 0/1/3 разные.
set -uo pipefail

ZERO="0000000000000000000000000000000000000000"

# ОКРУЖЕНИЕ GIT НЕ НАСЛЕДУЕТСЯ ПРОВЕРКАМИ. `git push` запускает хук с
# выставленным `GIT_DIR`, и дальше его наследует ВСЁ, что хук запускает, — в том
# числе `go test`. В дереве службы пробы заводят синтетические репозитории во
# временных каталогах (`tools/clagate`, `tools/standalonetargets`, гейты,
# читающие состав через `git ls-files`): с выставленным `GIT_DIR` переменная
# сильнее рабочего каталога, и фикстура пишет в индекс ЭТОЙ копии. Хук —
# граница, на которой окружение обрывается.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
if [ -z "$ROOT" ]; then
    echo "pre-push ОТКАЗ: это не рабочая копия git — проверять не в чем." >&2
    exit 4
fi
cd "$ROOT" || exit 4

TRUNK_REF="${KANAME_TRUNK_REF:-origin/main}"
ACCEPTANCE_DIR="docs/engineering/acceptance"
REVIEWS_DIR="docs/specs/reviews"

# ── ГРАНИЦА: ЧЕГО ЭТОТ ХУК НЕ ПРОВЕРЯЕТ ─────────────────────────────────────
#
# Граница ПЕЧАТАЕТСЯ, а не подразумевается: «зелёный хук» без неё читается шире,
# чем есть. Каждая строка называет ПРИЧИНУ, и причина — замер, а не мнение.
print_boundary() {
    cat <<'BOUNDARY'
== ГРАНИЦА — чего этот хук НЕ проверяет (и почему именно):
   • ГОНКИ (`-race`). На машине нет компилятора C: `go test -race` отвечает
     «-race requires cgo; enable cgo by setting CGO_ENABLED=1», `go env
     CGO_ENABLED` = 0, ни gcc, ни cc, ни clang в PATH нет. Пробы гоняются БЕЗ
     `-race`; гонки ищет ТОЛЬКО конвейер (задание `unit`).
   • `buf breaking` и адъюдикация объявленных разрывов. База сравнения —
     `…#branch=main` по сети к github; хук сети не требует и вердиктов из неё
     не берёт.
   • `gosec`. В PATH версия `dev`, пин конвейера — v2.28.0. Вердикты разных
     версий об одном дереве расходятся МОЛЧА; это «условие не создано», и
     ставить его в набор значило бы выдать чужой вердикт за свой.
   • Интеграция на контейнерах Postgres, сквозной набор newman, автономный
     стенд, сборка образа службы. Минуты и внешние условия; предмет конвейера.
   • `make model-canon-check` и `make check-permission-catalog`. Обе сверяют ДВА
     дерева и требуют чекаут PRO-Robotech/kacho ПОД корнем этого (PLATFORM_TREE
     / EDGE_TREE). В этой копии условие не создано by construction — обе
     отвечают кодом 2 «УСЛОВИЕ НЕ СОЗДАНО».
   • `go test ./tools/standalonetargets/` без `-short`. Собирает клон из состава
     коммита и зовёт каждую цель рецепта; конвейер даёт ей 25 минут.
   • СОДЕРЖИМОЕ приёмки. Проверка приёмок судит СУЩЕСТВОВАНИЕ записи вердикта на
     отпечаток и ничего не говорит о качестве ни приёмки, ни записи.
   • Статическую строку «Статус» в шапке приёмки. Сами приёмки этого дерева
     объявляют её НЕ вердиктом («статическая форма объявления»); читать её
     значило бы считать вердикты по упоминанию слова.
   • Всё, что УЖЕ влито. Предмет хука — ровно диапазон этой отправки.
BOUNDARY
}

# ── НАБОР ПРОВЕРОК ──────────────────────────────────────────────────────────
#
# Набор — ДАННЫЕ, и знаменатель берётся из их числа, а не из памяти. Состав
# выведен замером ЭТОГО дерева 2026-09-22, а не аналогией с соседним:
# у kaname 2944 файла Go в 166 пакетах, свои цели рецепта и свой дом приёмок.
# Время рядом — измеренное на тёплом кэше, чтобы цена хука была видна.
#
#   имя|что это|команда
roster() {
    cat <<'ROSTER'
gofmt|форма Go по ИНДЕКСУ git, включая отказ на пустом обходе (0,3с)|check_gofmt
build|go build ./... (2,6с)|go build ./...
vet|go vet ./... (1,2с)|go vet ./...
vet-integration|go vet -tags=integration ./... — иначе тегированное не проверяется нигде (3,0с)|go vet -tags=integration ./...
lint|make lint — golangci-lint пином v2.12.2 и конфигом .github/golangci.yml (2,1с)|make lint
proto-lint|make proto-lint — buf lint из каталога proto (0,5с)|make proto-lint
proto-gen-diff|make proto-gen-diff — стабы в синхроне с .proto (0,4с)|make proto-gen-diff
module-manifest|make module-manifest-check — манифест модуля против каталога прав (0,9с)|make module-manifest-check
helm-render-guard|make helm-render-guard — рендер чарта проходит страж старта (1,1с)|make helm-render-guard
operator-docs|make operator-docs-check — порождённое равно лежащему в дереве (1,0с)|make operator-docs-check
test-short|go test ./... -short -count=1 БЕЗ -race (46с; см. ГРАНИЦУ)|go test ./... -short -count=1
acceptance-verdict|приёмки диапазона: есть ли запись вердикта на ИХ отпечаток|check_acceptance_verdict
ROSTER
}

# gofmt в ТОЙ ЖЕ форме, что в конвейере: обход по индексу git, и ПУСТОЙ обход —
# отказ, а не «неотформатированных нет».
check_gofmt() {
    local files unformatted
    files="$(git ls-files '*.go')"
    if [ -z "$files" ]; then
        echo "ОТКАЗ: обход пуст — ни одного файла Go не прочитано."
        echo "«Ноль неотформатированных» здесь означало бы «ноль прочитанного»."
        return 1
    fi
    echo "прочитано файлов Go: $(printf '%s\n' "$files" | wc -l)"
    unformatted="$(gofmt -l $files)"
    local grc=$?
    # ТРИ ИСХОДА, А НЕ ДВА. 127/126 — gofmt не запустился (третья категория);
    # любой другой ненулевой — он ЗАПУСТИЛСЯ и не разобрал файл, и это находка.
    # Прежняя редакция отдавала `|| return 2` на оба, то есть печатала находку
    # как «не смотрели» — класс, ради которого написан весь этот хук.
    if [ "$grc" = 127 ] || [ "$grc" = 126 ]; then
        echo "gofmt не запустился (код $grc) — вердикта о форме нет"
        return 2
    fi
    if [ "$grc" != 0 ]; then
        echo "gofmt вышел кодом $grc — файл не разобран; это НАХОДКА, а не пропуск"
        printf '%s\n' "$unformatted"
        return 1
    fi
    if [ -n "$unformatted" ]; then
        echo "требуется gofmt:"
        printf '%s\n' "$unformatted"
        return 1
    fi
    echo "неотформатированных нет"
    return 0
}

# ── ПРИЁМКИ: ЗАПИСЬ ВЕРДИКТА НА ОТПЕЧАТОК ОТПРАВЛЯЕМОГО СОДЕРЖИМОГО ─────────
#
# ЧТО ЗДЕСЬ ПРЕДМЕТ. Вердикт приёмки в этом дереве привязан к ОТПЕЧАТКУ
# содержимого, а не к имени документа: запись лежит в
# `docs/specs/reviews/<приёмка>/<sha256>.yaml`, и сама называет свой предикат —
# `fingerprint_predicate: sha256sum docs/engineering/acceptance/<приёмка>.md`.
# Отпечаток здесь СНИМАЕТСЯ ТЕМ ЖЕ предикатом с содержимого, которое УЕЗЖАЕТ
# (`git show <отправляемый sha>:<путь>`), а не с рабочей копии: уезжает коммит.
#
# ЗАЧЕМ. 2026-09-22 тринадцать коммитов унесли две ОДОБРЕННЫЕ редакции, и ни
# одна проверка этого не видела: ни существование записи, ни её вердикт нигде не
# устанавливались.
#
# ЧТО СЧИТАЕТСЯ ОТКАЗОМ, А ЧТО — ТРЕТЬИМ СОСТОЯНИЕМ. Отказ ровно один:
# запись на отпечаток ЛЕЖИТ В РАБОЧЕЙ КОПИИ, но в отправляемый коммит НЕ ВОШЛА.
# Тогда редакция уезжает, а её вердикт остаётся на диске — то есть на сервере
# появляется содержимое, о котором читателю нечем узнать, что оно рассмотрено.
#
# «Записи нет нигде» отказом НЕ объявлено, и это ЗАМЕР, а не снисхождение:
# в дереве 46 приёмок, кругов ревью не было ни у одной из 33, а за 30 дней
# тронуты все 46 (54 коммита). Отказ на этом состоянии останавливал бы не
# нарушение, а сохранение работы — и был бы обойдён в первый же день, после
# чего хук перестал бы читаться вовсе. Состояние печатается СЛОВОМ, в зелёное не
# зачитывается и несёт координату, по которой запись обязана появиться.
check_acceptance_verdict() {
    local touched rel stem sha rec found_commit found_disk verdict
    local n_seen=0 n_recorded=0 n_unreviewed=0 n_stranded=0 rc=0

    touched="$(printf '%s\n' "$PUSH_TOUCHED" | grep -E "^${ACCEPTANCE_DIR}/.*\.md$" | sort -u)"
    if [ -z "$touched" ]; then
        echo "приёмок в диапазоне отправки нет — предмета у этой проверки нет"
        echo "(осмотрено файлов диапазона: $(printf '%s\n' "$PUSH_TOUCHED" | grep -c .))"
        return 0
    fi

    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        n_seen=$((n_seen + 1))
        stem="$(basename "$rel" .md)"
        sha="$(git show "${PUSH_TIP}:${rel}" 2>/dev/null | sha256sum | cut -d' ' -f1)"
        if [ -z "$sha" ] || [ "$sha" = "$(printf '' | sha256sum | cut -d' ' -f1)" ]; then
            echo "   • $stem — содержимое в ${PUSH_TIP} не прочитано (удалена или переименована?);"
            echo "     отпечаток не снят, вердикт по этой приёмке НЕ ВЫНЕСЕН"
            rc=2
            continue
        fi
        rec="${REVIEWS_DIR}/${stem}/${sha}.yaml"
        found_commit=no
        git cat-file -e "${PUSH_TIP}:${rec}" 2>/dev/null && found_commit=yes
        found_disk=no
        [ -f "$ROOT/$rec" ] && found_disk=yes

        echo "   • $stem"
        echo "     отпечаток ${sha}"
        echo "     предикат  sha256sum $rel   (на ${PUSH_TIP})"
        if [ "$found_commit" = yes ]; then
            verdict="$(git show "${PUSH_TIP}:${rec}" 2>/dev/null |
                       sed -n 's/^verdict:[[:space:]]*//p' | head -1)"
            echo "     запись    $rec — В ОТПРАВКЕ ЕСТЬ, вердикт: ${verdict:-<поле verdict не прочитано>}"
            n_recorded=$((n_recorded + 1))
        elif [ "$found_disk" = yes ]; then
            echo "     запись    $rec — НА ДИСКЕ ЕСТЬ, В ОТПРАВКУ НЕ ВОШЛА"
            echo "     ОТКАЗ: редакция уезжает, её вердикт остаётся в рабочей копии."
            echo "     Тому, кто прочтёт отправленное, нечем узнать, что она рассмотрена."
            echo "     Исход один: git add $rec и коммит тем же заходом."
            n_stranded=$((n_stranded + 1))
            rc=1
        else
            echo "     запись    $rec — НЕТ НИ В ОТПРАВКЕ, НИ НА ДИСКЕ"
            echo "     состояние: РЕДАКЦИЯ НЕ РАССМОТРЕНА. Кругов у документа в отправке:" \
                 "$(git ls-tree --name-only "${PUSH_TIP}" "${REVIEWS_DIR}/${stem}/" 2>/dev/null | grep -c . )."
            echo "     В зелёное это не зачтено. Вердикт появится ровно по этой координате."
            n_unreviewed=$((n_unreviewed + 1))
        fi
    done <<< "$touched"

    echo "   перепись: приёмок в диапазоне $n_seen · с записью на свой отпечаток $n_recorded" \
         "· не рассмотрено $n_unreviewed · вердикт застрял на диске $n_stranded"
    return $rc
}

# ── ДИАПАЗОН ОТПРАВКИ: СПРАШИВАЕМ У GIT, А НЕ ВЫВОДИМ ИЗ ИМЕНИ ВЕТКИ ─────────
#
# git передаёт хуку на stdin по строке на каждую отправляемую ссылку:
# `<local_ref> <local_sha> <remote_ref> <remote_sha>`. Это авторитетный ответ на
# «что уедет»; ни точка ветвления, ни вышестоящая ветка его не заменяют.
#
# РАЗЛИЧЕНИЕ, БЕЗ КОТОРОГО У ХУКА БЫЛА БЫ ДЫРА В ПОЛ-ЛАДОНИ. Пустой stdin и
# «все строки с нулевым local_sha» — РАЗНЫЕ вещи. Второе есть отправка одних
# удалений: наружу не едет ни один коммит, и это ПЕРВАЯ форма нуля. Первое
# означает, что хук запущен НЕ отправкой (git всегда пишет хотя бы одну строку),
# и тогда выйти нулём значило бы отдать зелёное всякому, кто позовёт файл
# руками. В этом случае предмет — HEAD, и проверки гоняются.
read_push_subject() {
    local line lref lsha rref rsha base seen=0 live=0 touched="" tip=""
    while read -r line; do
        [ -n "$line" ] || continue
        seen=$((seen + 1))
        read -r lref lsha rref rsha <<< "$line"
        [ "$lsha" = "$ZERO" ] && continue
        live=$((live + 1))
        tip="$lsha"
        if [ "$rsha" != "$ZERO" ] && git cat-file -e "$rsha" 2>/dev/null; then
            base="$rsha"
        else
            base="$(git merge-base "$lsha" "$TRUNK_REF" 2>/dev/null)" || base=""
        fi
        if [ -z "$base" ]; then
            PUSH_RANGES="${PUSH_RANGES:+$PUSH_RANGES }<база не построена для $lref>"
            PUSH_BASELESS=1
            continue
        fi
        PUSH_RANGES="${PUSH_RANGES:+$PUSH_RANGES }${base}..${lsha}"
        touched="$touched
$(git diff --name-only "$base" "$lsha" 2>/dev/null)"
    done
    PUSH_SEEN="$seen"
    PUSH_LIVE="$live"
    PUSH_TIP="$tip"
    PUSH_TOUCHED="$touched"
}

PUSH_RANGES=""
PUSH_BASELESS=0
PUSH_SEEN=0
PUSH_LIVE=0
PUSH_TIP=""
PUSH_TOUCHED=""

case "${1:-}" in
    --boundary) print_boundary; exit 0 ;;
    --roster)
        printf '%s\n' "== объявленный набор (знаменатель хука):"
        roster | nl -ba -w2 -s'. ' | sed 's/|/  ·  /g'
        printf '%s\n' "== объявлено проверок: $(roster | grep -c .)"
        exit 0
        ;;
    --wiring)
        common="$(git rev-parse --git-common-dir 2>/dev/null)" || common=""
        case "$common" in /*) ;; *) common="$ROOT/$common" ;; esac
        stub="$common/hooks/pre-push"
        if [ ! -e "$stub" ]; then
            echo "провязки НЕТ: $stub не существует — git этот хук не позовёт." >&2
            exit 1
        fi
        if ! grep -q 'scripts/hooks/pre-push' "$stub" 2>/dev/null; then
            echo "провязка ЕСТЬ, но переходник $stub не ссылается на scripts/hooks/pre-push." >&2
            exit 1
        fi
        if grep -qE 'проверок НЕ БЫЛО' "$stub" 2>/dev/null && grep -qE '^[[:space:]]*exit 0' "$stub" 2>/dev/null; then
            echo "переходник $stub провязан, НО его ветка «нет скрипта» выходит НУЛЁМ:" >&2
            echo "отсутствие хука он объявляет успехом. Это тот же fail-open, который" >&2
            echo "чинит этот файл, — в самом переходнике. Он не отслеживается git и" >&2
            echo "чинится у каждого своей рукой." >&2
            exit 1
        fi
        echo "провязано: $stub → $ROOT/scripts/hooks/pre-push"
        exit 0
        ;;
    --self-test) SELF_TEST=1 ;;
    "") SELF_TEST=0 ;;
    *) echo "pre-push: неизвестный режим «$1»" >&2; exit 64 ;;
esac

# ── САМОПРОБА: ДОКАЗАТЬ ОПЫТОМ, ЧТО КОДЫ РАЗНЫЕ ─────────────────────────────
#
# Инъекция, а не прочтение. Самопроба подкладывает в PATH подставные `make`,
# `go` и `gofmt` с заданным кодом возврата и ПЕРЕЗАПУСКАЕТ ЭТОТ ЖЕ ФАЙЛ целиком,
# со синтетическим stdin. Судится наблюдаемый код процесса, а не внутренняя
# ветка: заголовок пробы иначе был бы шире её тела.
#
# Четыре прогона, и каждый роняет РОВНО своё:
#   A — все приборы отвечают 0        → ожидается 0 («проверки прошли»);
#   B — один прибор отвечает 2        → ожидается 3 («прибор не запустился»);
#   C — один прибор отвечает 1        → ожидается 1 («находка»);
#   D — gofmt отвечает 127 «нет команды» → ожидается 3 («прибор не запустился»);
#   E — уезжает НЕ та вершина, что в копии → ожидается 4 («судил бы не то»).
# Свойство, ради которого проба существует: A ≠ B, A ≠ D и A ≠ E. НИ ОДНА форма
# «проверок не было» не приходит тем же кодом, что «проверки прошли».
if [ "${SELF_TEST:-0}" = "1" ]; then
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/kaname-prepush-selftest.XXXXXX")" || exit 4
    trap 'rm -rf "$tmp"' EXIT
    head_sha="$(git rev-parse HEAD)"
    synth_stdin="refs/heads/probe $head_sha refs/heads/probe $ZERO"

    shim() { # shim <каталог> <имя> <код>
        # Подставной прибор пишет в stderr: его СТРОКА не должна попадать в
        # stdout, который проверки разбирают как свой результат (gofmt -l).
        printf '#!/bin/sh\necho "подставной %s: код %s" >&2\nexit %s\n' "$2" "$3" "$3" > "$1/$2"
        chmod +x "$1/$2"
    }
    scenario() { # scenario <имя> <ожидаемый код> <код make> <код go> <код gofmt> [drop|other-tip]
        local name="$1" want="$2" bin got feed="$synth_stdin"
        bin="$tmp/bin-$name"; mkdir -p "$bin"
        # Драйверы сборки подставляются ВСЕГДА и никогда не выпадают в
        # настоящие: `make proto-gen-diff` начинается с `rm -rf pkg/api`, а
        # `buf generate` зовёт плагины через `go run` — с подставным `go`
        # каталог остаётся пустым. Отсутствующим делается только `gofmt`:
        # он ничего не порождает, поэтому «прибор не запустился» получается
        # без единого следа в дереве.
        shim "$bin" make "$3"
        shim "$bin" go "$4"
        shim "$bin" buf 0
        # ПРЕДЕЛ ЭТОГО СЦЕНАРИЯ НАЗВАН, А НЕ ЗАМАЗАН. «Убрать прибор из PATH»
        # здесь недостижимо честно: $bin лишь ЗАТЕНЯЕТ (без шима сценарий
        # проваливался в настоящий gofmt и давал 0 вместо 3), а файл без бита
        # исполнения оболочка ПРОПУСКАЕТ и ищет дальше — тоже настоящий.
        # Вычистить PATH целиком нельзя: хуку оттуда нужны git, awk и sed, и
        # собранный руками PATH проверял бы сборку, а не хук.
        # Поэтому подставной gofmt отвечает 127 — тем самым кодом, которым
        # оболочка сообщает «команды нет». Под пробой здесь РАЗБОР КОДА: что
        # 127 попадает в «не исполнено», а не в «отказ» и не в «зелёное».
        [ "${6:-}" = "drop-gofmt" ] && set -- "$1" "$2" "$3" "$4" 127 "${6:-}"
        shim "$bin" gofmt "$5"
        # Сценарий E: вершина отправки — НЕ та, что в рабочей копии. Прародитель
        # HEAD годится: он существует, значит отказ придёт от расхождения, а не
        # от нечитаемой ссылки.
        [ "${6:-}" = "other-tip" ] &&
            feed="refs/heads/probe $(git rev-parse HEAD~1) refs/heads/probe $ZERO"
        printf '%s\n' "$feed" |
            env PATH="$bin:$PATH" bash "$ROOT/scripts/hooks/pre-push" > "$tmp/out-$name" 2>&1
        got=$?
        if [ "$got" = "$want" ]; then
            echo "  [ОК]     сценарий $name — код $got (ожидался $want)"
        else
            echo "  [ПРОВАЛ] сценарий $name — код $got, ожидался $want"
            sed 's/^/           | /' "$tmp/out-$name" | tail -25
            FAILED=1
        fi
    }
    FAILED=0
    # СЛЕД В ДЕРЕВЕ — ЧАСТЬ СВОЙСТВА ПРОБЫ. Измерено на этой же пробе: сценарий,
    # пускавший настоящий `make` с подставным `go`, удалил 87 порождённых файлов
    # и оставил дерево без заглушек. Проба, портящая предмет, о котором судит,
    # даёт зелёное о том, чего уже нет. Считается ОТСЛЕЖИВАЕМОЕ: неотслеживаемое
    # тут заводит сам хук (временные каталоги лежат вне дерева).
    dirty_before="$(git status --porcelain --untracked-files=no | grep -c .)"
    echo "== самопроба хука отправки: инъекция подставными приборами"
    echo "   дерево до пробы: тронутых отслеживаемых $dirty_before"
    scenario A 0 0 0 0
    scenario B 3 2 0 0
    scenario C 1 1 0 0
    scenario D 3 0 0 0 drop-gofmt
    scenario E 4 0 0 0 other-tip

    # ГАРД ТЕКСТА ОТКАЗОВ. Сообщения подставляют величины ($PUSH_TIP и прочие),
    # поэтому их heredoc'и не экранированы — и подстановка КОМАНДЫ в них
    # исполнится. Измерено на этом файле: строка «(или `git stash`)» исполнила
    # git stash и убрала 87 файлов рабочей копии, дважды подряд. Текст отказа —
    # часть свойства проверки; текст, который ДЕЙСТВУЕТ, свойство отменяет.
    guard_out="$(awk '
      /<<[[:space:]]*'"'"'[A-Za-z_][A-Za-z0-9_]*'"'"'[[:space:]]*$/ { quoted=1; next }
      /<<[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*$/ && !quoted {
          d=$0; sub(/.*<<[[:space:]]*/,"",d); sub(/[[:space:]]*$/,"",d); open=d; next }
      open != "" && $0 ~ ("^[[:space:]]*" open "[[:space:]]*$") { open=""; next }
      open != "" && (index($0,"`") || index($0,"$(")) { print NR ": " $0 }
      { quoted=0 }
    ' "$ROOT/scripts/hooks/pre-push")"
    if [ -n "$guard_out" ]; then
        echo "  [ПРОВАЛ] гард текста отказов — подстановка команды в неэкранированном heredoc:"
        printf '%s\n' "$guard_out" | sed 's/^/           | /'
        FAILED=1
    else
        echo "  [ОК]     гард текста отказов — подстановок команды в сообщениях нет"
    fi
    dirty_after="$(git status --porcelain --untracked-files=no | grep -c .)"
    if [ "$dirty_after" != "$dirty_before" ]; then
        echo "  [ПРОВАЛ] проба ОСТАВИЛА СЛЕД: тронутых отслеживаемых было" \
             "$dirty_before, стало $dirty_after"
        git status --porcelain --untracked-files=no | head -5 | sed 's/^/           | /'
        FAILED=1
    else
        echo "  [ОК]     след в дереве: тронутых отслеживаемых $dirty_after — как было"
    fi
    if [ "$FAILED" = 0 ]; then
        echo "== самопроба: свойство ДОКАЗАНО — «проверки прошли» (0), «находка» (1)"
        echo "   и «прибор не запустился» (3) приходят РАЗНЫМИ кодами."
        exit 0
    fi
    echo "== самопроба ПРОВАЛЕНА: хук не различает исходы, ради которых написан." >&2
    exit 1
fi

# ── ОСНОВНОЙ ХОД ────────────────────────────────────────────────────────────
read_push_subject

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
echo "== pre-push kaname: локальные проверки перед отправкой ветки «$branch»"
echo "   обойти можно только 'git push --no-verify' — второй двери у этого хука нет"

if [ "$PUSH_SEEN" -gt 0 ] && [ "$PUSH_LIVE" -eq 0 ]; then
    echo "== ПРЕДМЕТА НЕТ: отправка несёт только УДАЛЕНИЕ ссылок ($PUSH_SEEN шт.) —"
    echo "   наружу не едет ни один коммит. Это первая форма нуля: проверять нечего."
    echo "== ЗНАМЕНАТЕЛЬ: объявлено $(roster | grep -c .) · исполнено 0 · отказов 0 · НЕ исполнено 0"
    print_boundary
    exit 0
fi

if [ "$PUSH_SEEN" -eq 0 ]; then
    # stdin пуст — значит, хук позван НЕ отправкой. Предмет берётся от HEAD, и
    # это названо вслух: молчаливая подстановка сделала бы зелёное неотличимым
    # от зелёного настоящей отправки.
    PUSH_TIP="$(git rev-parse HEAD 2>/dev/null)"
    base="$(git merge-base HEAD "$TRUNK_REF" 2>/dev/null)" || base=""
    if [ -n "$base" ]; then
        PUSH_RANGES="${base}..HEAD"
        PUSH_TOUCHED="$(git diff --name-only "$base" HEAD 2>/dev/null)"
    else
        PUSH_BASELESS=1
    fi
    echo "   ВНИМАНИЕ: на stdin не было ни одной строки — хук запущен НЕ отправкой."
    echo "   Предмет взят от HEAD ($PUSH_TIP) против $TRUNK_REF."
fi

if [ "$PUSH_BASELESS" = "1" ] || [ -z "$PUSH_TIP" ]; then
    cat >&2 <<MSG
== pre-push ОТКАЗ: ХУК НЕ УСТАНОВИЛ, ЧТО УЕЗЖАЕТ.
   База диапазона не построена: ссылки $TRUNK_REF в этом клоне нет, а удалённая
   сторона отправляемой ветки пуста. Это не «находок нет» — это «не смотрели»,
   и проверки, чей предмет есть диапазон, вердикта не дали бы ни одного.
   Условие создаётся так:  git fetch --no-tags origin main
MSG
    exit 4
fi

echo "   диапазон(ы): $PUSH_RANGES"
echo "   уезжает файлов: $(printf '%s\n' "$PUSH_TOUCHED" | grep -c .)"

# ── ПРОВЕНАНС: ЧТО ИМЕННО СУДИЛОСЬ ──────────────────────────────────────────
#
# Уезжает КОММИТ, а `go build`, `make lint` и пробы судят РАБОЧУЮ КОПИЮ. Пока
# они совпадают, разница незаметна; когда расходятся — вердикт описывает не то,
# что поедет, и молчит об этом.
#
# Это не гипотеза. Первый же сквозной прогон этого хука 2026-09-22 дал `go build`
# «no required module provides package …/pkg/api/…v1», а повторный через минуту —
# 12 из 12 исполненных. Разбор назвал причину, и она оказалась НЕ той, на которую
# думали первым делом: копия здесь общая, и списать было соблазнительно на
# соседнего писателя, но писателя не было — `ps` пуст, пять замеров подряд
# показали дерево неподвижным. Портила его САМА самопроба этого файла (разбор — в
# её шапке). Вывод от смены виновника не изменился: вердикт о рабочей копии не
# есть вердикт о том, что уезжает, и отличить одно от другого было нечем.
#
# Поэтому провенанс ПЕЧАТАЕТСЯ, а расхождение есть ОТКАЗ кодом 4: «я судил не
# то, что уезжает» — это не находка и не зелёное, это отсутствие вердикта.
head_now="$(git rev-parse HEAD 2>/dev/null)"
dirty_tracked="$(git status --porcelain --untracked-files=no 2>/dev/null | grep -c .)"
dirty_untracked="$(git status --porcelain --untracked-files=all 2>/dev/null | grep -c '^??')"
echo "   судится РАБОЧАЯ КОПИЯ: HEAD=$head_now · тронутых отслеживаемых $dirty_tracked · неотслеживаемых $dirty_untracked"
if [ "$head_now" != "$PUSH_TIP" ] || [ "$dirty_tracked" -gt 0 ]; then
    cat >&2 <<MSG

== pre-push ОТКАЗ: ХУК СУДИЛ БЫ НЕ ТО, ЧТО УЕЗЖАЕТ — отправка остановлена.

  уезжает вершина : $PUSH_TIP
  судилась бы     : $head_now (тронутых отслеживаемых файлов $dirty_tracked)

Сборка, линт и пробы читают рабочую копию, а наружу едет коммит. Разойдясь, они
дают вердикт о содержимом, которого на сервере не будет, — и «зелёное» означало
бы меньше, чем читатель думает. Находок здесь НЕТ НИ ОДНОЙ: их не искали.

Исходы: закоммитьте тронутое (или уберите в git stash) и повторите;
        отправляйте вершину, на которой стоите;
        либо явно — git push --no-verify — зная, что вердикта нет.
MSG
    exit 4
fi
echo

declared=0; executed=0; failed=0; notrun=0
failed_names=""; notrun_names=""
logdir="$(mktemp -d "${TMPDIR:-/tmp}/kaname-prepush.XXXXXX")" || exit 4
trap 'rm -rf "$logdir"' EXIT

total="$(roster | grep -c .)"
while IFS='|' read -r name what cmd; do
    [ -n "$name" ] || continue
    declared=$((declared + 1))
    printf -- '-- [%d/%d] %s — %s\n' "$declared" "$total" "$name" "$what"
    started=$(date +%s)
    # КОД БЕРЁТСЯ У ТОГО, КТО ЕГО ПРОИЗВЁЛ: вывод уходит в файл, `$?` читается
    # сразу за процессом проверки. Ни трубы, ни `tee`, ни шага после неё.
    $cmd > "$logdir/$name.log" 2>&1
    rc=$?
    spent=$(( $(date +%s) - started ))
    case "$rc" in
        0)
            executed=$((executed + 1))
            printf '   ОК (%dс)\n' "$spent"
            [ "$name" = "acceptance-verdict" ] && sed 's/^/   /' "$logdir/$name.log"
            ;;
        2|126|127)
            # Словарь этого дерева: код 2 у целей рецепта означает «УСЛОВИЕ НЕ
            # СОЗДАНО — сверка НЕ ИСПОЛНЯЛАСЬ», а не находку (см. make lint,
            # model-canon-check, check-permission-catalog). 126/127 — прибора
            # нет в PATH либо он не исполняется. Все три — третья категория.
            notrun=$((notrun + 1))
            notrun_names="$notrun_names
   • $name — код $rc: $(head -1 "$logdir/$name.log" 2>/dev/null)"
            printf '   НЕ ИСПОЛНЕНА (код %d, %dс)\n' "$rc" "$spent"
            ;;
        *)
            executed=$((executed + 1))
            failed=$((failed + 1))
            failed_names="$failed_names
   • $name — код $rc: $(grep -m1 -E '^--- FAIL:|^FAIL[[:space:]]|^ОТКАЗ|^[[:space:]]*Error:|требуется gofmt|\.go:[0-9]+:' "$logdir/$name.log" 2>/dev/null || head -1 "$logdir/$name.log" 2>/dev/null)"
            printf '   ОТКАЗ (код %d, %dс)\n' "$rc" "$spent"
            sed 's/^/   | /' "$logdir/$name.log" | tail -30
            ;;
    esac
done < <(roster)

echo
echo "== ЗНАМЕНАТЕЛЬ: объявлено $declared · исполнено $executed · отказов $failed · НЕ исполнено $notrun"
if [ "$notrun" -gt 0 ]; then
    echo "== НЕ ИСПОЛНЕНЫ поимённо (числа мало — нужны имена):$notrun_names"
fi
if [ "$failed" -gt 0 ]; then
    echo "== ОТКАЗАЛИ поимённо:$failed_names"
fi
print_boundary

if [ "$notrun" -gt 0 ]; then
    cat >&2 <<MSG

== pre-push ОТКАЗ: ПРИБОР НЕ ЗАПУСТИЛСЯ — отправка остановлена.

Объявлено $declared проверок, исполнено $executed, НЕ исполнено $notrun. По
неисполненным вердикта нет НИ ОДНОГО: здесь «находок нет» означает «не смотрели».
Это ВТОРАЯ форма нуля, и она есть отказ — ровно то свойство, ради которого этот
хук написан: прежде его роль играл переходник, который печатал «проверок НЕ БЫЛО»
и выходил успехом.

Три исхода, четвёртого нет:
  создайте условие, названное в строке проверки выше;
  снимите проверку из набора ОТДЕЛЬНЫМ изменением, назвав причину в этом файле;
  отправьте явно — git push --no-verify — зная, что вердикта нет.
MSG
    exit 3
fi

if [ "$failed" -gt 0 ]; then
    cat >&2 <<MSG

== pre-push ОТКАЗ: локальные проверки красные — отправка остановлена.

Это не придирка хука: ровно эти проверки упадут в конвейере, только ответ придёт
через двадцать минут и займёт ранер.

Три исхода, четвёртого нет:
  почините найденное;
  объявите слом там, где он объявляется (proto/declared-breaks.yaml);
  отправьте черновик явно — git push --no-verify.
MSG
    exit 1
fi

echo "== pre-push: локальные проверки зелёные — исполнено $executed из $declared,"
echo "   НЕ исполненных нет, отказов нет. Область зелёного — ровно ГРАНИЦА выше."
exit 0
