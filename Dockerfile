FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/golang:1.26-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

# КОНТЕКСТ СБОРКИ — КАТАЛОГ СЛУЖБЫ, И БОЛЬШЕ НИЧЕГО.
#
# Здесь стояло утверждение, пережившее прежнее полирепо: будто служба несёт
# готовые стабы контрактов собственным каталогом и подключает фундамент
# versioned-модулем под именем прежнего репозитория. Ни одного из трёх не
# существовало — ни того каталога, ни модуля с тем именем, ни самодостаточности:
# у службы не было своего go.mod, образ собирался с контекстом в КОРНЕ монорепо,
# а пути сборки начинались с имени каталога службы. Читающий шапку заключал, что
# отдельная сборка уже устроена, и не заводил того, чем она держится.
#
# Мёртвые координаты здесь намеренно не воспроизводятся в форме пути: путь в
# комментарии читается как утверждение о дереве, и проверка рядом (гейт
# supplyhygiene) справедливо считает такую цитату находкой — она поймала её и в
# первой редакции этого самого абзаца.
#
# Что верно теперь. Служба несёт СВОЙ модуль (`go.mod`, путь
# `github.com/PRO-Robotech/kacho-iam`), поэтому контекст сборки — этот каталог:
# `docker build -f Dockerfile <каталог службы>`. Соседних деревьев в контексте
# нет и не требуется.
#
# ЧТО СБОРКЕ НУЖНО ИЗВНЕ — названо прямо, а не подразумевается. Ровно одно:
# модуль платформы `github.com/PRO-Robotech/kacho`, объявленный в `go.mod` по
# версии. Он приезжает с прокси модулей Go, как всякая внешняя зависимость,
# поэтому сборка сетевая — как и была. Дерева монорепо на диске она не требует;
# это и проверяется прогоном `go build` из копии каталога, лежащей отдельно.
COPY . .

# КЭШ КОМПИЛЯЦИИ — ОБЩИЙ НА ВСЕ ОБРАЗЫ ЭТОГО BUILDER'А.
#
# Прежняя редакция обосновывала кэш тем, что «восемь образов компилируют ОДИН И
# ТОТ ЖЕ модуль». Для этого образа это больше не так: модуль у службы свой.
# Довод от этого не отпал, а сменил основание — общей осталась НЕ принадлежность
# одному модулю, а множество сторонних зависимостей: их граф у службы и у
# соседей пересекается почти целиком, а кэш buildkit принадлежит builder'у, а не
# образу.
#
# ЭТО НЕ КЛАСС «КЭШ СОХРАНИЛ НЕУДАЧУ»: кэш компиляции Go контент-адресуем —
# недописанная или битая запись не находится по хэшу входов и просто вызывает
# перекомпиляцию. Гейтить сохранение по исходу шага здесь нечего.
#
# Директивы `# syntax=` намеренно нет: встроенный frontend buildkit `--mount`
# понимает (проверено), а `docker/dockerfile:1` — движущийся тег, то есть версия
# менялась бы без правки дерева, плюс сетевая тяга на каждом builder'е. Сборка со
# ВЫКЛЮЧЕННЫМ buildkit падает громко и по имени («requires BuildKit»).

# СЕТЕВАЯ ПОВЕРХНОСТЬ СБОРКИ РАВНА ЕЁ ГРАФУ ИМПОРТОВ.
#
# Здесь стоял `go mod download` без аргументов. Он тянет модули, ОБЪЯВЛЕННЫЕ в
# `go.mod`, тогда как компилируется только импортируемое. Каждая лишняя загрузка
# — ещё один способ уронить сборку по причине, к продукту отношения не имеющей;
# так и вышло однажды: образ упал на модуле поставщика инструментов
# инфраструктуры, которого его бинарь не компилирует.
#
# `go list -deps` на ТЕХ ЖЕ пакетах, что собираются ниже, разрешает и укладывает
# в кэш ровно их транзитивные модули. Список намеренно повторяет строку сборки:
# разойдясь, он не сломает сборку (недостающее догрузит `go build`), но
# расхождение видно глазом в соседних строках.
RUN --mount=type=cache,target=/go/pkg/mod \
    go list -deps ./cmd/kacho-iam ./cmd/migrator >/dev/null
# Skill evgeniy §9 K.1 / AP-9: независимые binary в одном образе.
# kacho-iam       — gRPC API-сервер (единственный subcommand — `serve`).
# kacho-migrator  — CLI миграций (cobra: up|down|status|create), используется
#                   init-container'ом перед стартом основного pod'а.
#
# JWKS-ротатора здесь НЕТ и быть не должно: служба не чеканит токены провайдера и
# не владеет его ключом подписи. Она ПРОКСИРУЕТ публичный набор ключей провайдера
# байт-в-байт (internal/handler/jwksproxyhttp, :9097). Ротировать здесь нечего —
# см. комментарий там же.
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /kacho-iam ./cmd/kacho-iam \
 && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /kacho-migrator ./cmd/migrator

FROM mirror.gcr.io/library/alpine:3.24
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates
COPY --from=builder /kacho-iam /usr/local/bin/kacho-iam
COPY --from=builder /kacho-migrator /usr/local/bin/kacho-migrator
# ПРОВЕНАНС ОБРАЗА — из какого дерева он собран. Клеймо и файл берут величину из
# ОДНОГО `ARG`, поэтому разойтись не могут. Файл нужен потому, что у РАБОТАЮЩЕГО
# контейнера клеймо не прочесть ничем, кроме демона хоста или реестра, — а у
# управляемого кластера нет ни того, ни другого, тогда как `kubectl exec … cat`
# есть всегда. Пустое умолчание намеренно: сборка руками ревизии знать не обязана,
# а цель провенанса скажет словами, что величина не проставлена.
# Разбор целиком и требование к КАЖДОЙ сборке дерева живут в рецепте развёртывания
# монорепо — здесь их координаты намеренно не воспроизводятся: в контексте этой
# сборки такого каталога нет, и путь читался бы как обещание того, чего рядом не
# существует.
ARG KACHO_IMAGE_REVISION=""
ARG KACHO_IMAGE_VERSION=""
LABEL org.opencontainers.image.revision="$KACHO_IMAGE_REVISION" \
      org.opencontainers.image.version="$KACHO_IMAGE_VERSION"
RUN mkdir -p /etc/kacho && printf '%s\n' "$KACHO_IMAGE_REVISION" > /etc/kacho/image-revision

USER 65532
ENTRYPOINT ["/usr/local/bin/kacho-iam"]
