type vpc_address_pool
  relations
    # kacho:latent — cluster-anchored admin resource; its RPCs gate on
    # cluster:cluster_kacho_root#system_admin directly, so no module registers an
    # address pool and nothing writes this pointer today. Declared ahead of that
    # producer deliberately: the type is admin-curated and the anchor is what the
    # super-admin cascade below derives over. The marker expires by itself — the
    # moment a producer appears, the gate demands it be removed.
    define cluster: [cluster]
    define super_admin: any_admin from cluster
    define admin: [user, service_account] or super_admin
    define viewer: [user, service_account] or admin
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin

# ---------------------------------------------------------------------------
# Compute domain.
#
# `compute_disk` / `compute_image` / `compute_snapshot` were declared here and are
# not any more. Block storage belongs to kacho-storage — see `storage_volume` /
# `storage_snapshot` / `storage_image` below — and compute's duplicate of those
# resources is retired: no tables, no services, no routes, no catalog entries.
# Declaring an authorization type for a resource nothing serves is not harmless
# housekeeping: it stays grantable, bindable and materializable, so a binding on
# it writes per-object tuples for objects that will never exist.
#
# Do not re-add them without the resource. If some future compute-owned disk ever
# arrives, it declares its own type together with its tables, its RPCs and its
# catalog entries — and the roles/selectors that grant it, which migration 0074
# withdrew.
# ---------------------------------------------------------------------------

type compute_instance
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define ssh: [user with mfa_fresh, service_account] or admin
    define console: [user with mfa_fresh] or admin
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin
    # realization_writer — входящий канал плоскости исполнения:
    # `InternalRealizationService/ReportInstanceRealization` (:9091, взаимный TLS).
    #
    # Отношение объявлено ЗДЕСЬ, потому что каталог прав его ТРЕБУЕТ. Запись
    # каталога, ссылающаяся на отношение, которого нет в модели, — не «строгий по
    # умолчанию отказ», а сломанная по построению проверка: хранилище прав
    # отвергает такой вопрос как ошибку модели, и RPC отказывает КАЖДОМУ
    # предъявителю. Тот же класс уже стоил трёх разборов (`nlb_listener`
    # `project`, `storage_*`, `nlb` `announce_writer`).
    #
    # Носитель — ТОЛЬКО исполнитель этой машины. Право не выдаётся заранее и не
    # распространяется на облако: оно материализуется вместе с обменом владением
    # (узел взял машину) и снимается вместе с ним. Иначе предъявитель
    # сертификата отчитывался бы о ЛЮБОЙ машине облака, а наблюдаемое состояние —
    # это то, на что опирается решение о перезапуске.
    #
    # Арендатор его не получает ни при какой роли: наблюдаемое сообщает
    # исполнитель, и возможность «сообщить о себе» сделала бы факт исполнителя
    # управляемым извне.
    define realization_writer: [service_account]

# compute_placement_group — правило взаимного размещения машин как объект прав.
#
# Тип нужен по той же причине, что у ключа входа: запрос на чтение, правку и
# снятие несёт ТОЛЬКО идентификатор группы, поэтому край не может вывести проект
# иначе как резолвом цели у владельца прав.
type compute_placement_group
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin

# compute_guest_access_key — публичный ключ входа в машину как ОТДЕЛЬНЫЙ объект
# прав.
#
# Тип нужен не ради симметрии: запрос на чтение и снятие ключа несёт ТОЛЬКО его
# идентификатор, поэтому край не может вывести проект иначе как резолвом цели у
# владельца прав. Без пообъектного типа пришлось бы принимать проект от
# вызывающего — то есть спрашивать разрешения у того, кого проверяем.
#
# `ssh`/`console` здесь не объявлены: они про вход В МАШИНУ, а не про управление
# перечнем ключей. Объявить их значило бы завести отношение, которого никто не
# спрашивает.
type compute_guest_access_key
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin

type nlb_network_load_balancer
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin
    # announce_writer — inbound data-plane feedback gate for
    # `InternalLoadBalancerAnnounceService/ReportAnnounceState` (:9091, mTLS).
    # The permission catalog REQUIRED this relation on this type while the model
    # never declared it, so the engine rejected the Check as a model validation
    # error and the RPC was denied for EVERY subject — a broken-by-construction
    # gate, not a least-priv default (same defect class as #68 nlb_listener
    # `project` and #71 storage_* types).
    #
    # Bearer — the DATA PLANE announcer only: it is the sole producer of
    # announce-state (BGP session up/down, route/VRF id, kernel-programming
    # status, numeric infra id). That state is infra-sensitive (security.md) and
    # tenants neither produce nor read it. Hence, deliberately:
    #   * `[service_account]` ONLY — no `user`, no `group#member`, no `user:*`.
    #     A human/tenant principal cannot even be WRITTEN as the subject of this
    #     tuple (the engine rejected the write), so it can never be handed out via a
    #     custom role or a group;
    #   * NO `or admin|editor|viewer` derivation — a project editor must NOT be
    #     able to forge the announce-state of a load balancer;
    #   * nothing derives FROM it — the data-plane writer gains no CRUD.
    # It is also outside the closed verb set {get,list,create,update,delete} the
    # iam reconciler materializes from role permissions, so no AccessBinding can
    # produce it: the only way to hold it is an explicit per-load-balancer tuple
    # written for the data-plane service account when the data plane is
    # provisioned. Until then the RPC stays uniformly fail-closed — which is the
    # correct state, since nothing legitimately reports announce-state yet.
    define announce_writer: [service_account]

type nlb_target_group
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin
    # NLB-TGT-1 — управление СОСТАВОМ группы отделено от изменения самой группы.
    # Первый тип платформы, чей набор глаголов ШИРЕ канонического CRUD: набор — атрибут
    # типа (authzmap.typeVerbRelations), и гейт дрейфа сверяет его с этими строками
    # потипово (TestDrift_TypeVerbSetsMatchModelExactly).
    #
    # Зачем отдельные отношения: роль `loadbalancer.target_manager` объявляет
    # `addTargets`/`removeTargets` и показывает их как то, что даёт. Пока оба RPC
    # гейтились на `v_update`, выдать право управлять составом, не выдав права менять
    # саму группу, было НЕЛЬЗЯ — роль была читательской вопреки своему имени.
    #
    # Почему НАДМНОЖЕСТВО `v_update`, а не самостоятельные отношения: у сегодняшнего
    # редактора лежит прямой кортеж `v_update`, и ветвь `or v_update` разрешает ему
    # новый вопрос ТЕМ ЖЕ кортежем. Значит переключение гейтинга не требует
    # ре-материализации ни одной выдачи и не имеет окна, в котором прежний держатель
    # отказан. `v_update` уже включает `super_admin`, поэтому каскад трёх верхних
    # уровней наследуется без отдельного упоминания. Надмножество ОДНОСТОРОННЕ:
    # держатель управления составом права менять саму группу не получает.
    #
    # Имена не выбраны, а выведены: реконсайлер собирает имя как
    # `"v_" + domain.NormalizeVerb(<авторский глагол>)`, поэтому `addTargets` даёт
    # ровно `v_addtargets`. Написать здесь иначе значило бы объявить отношение, по
    # которому эмиттер никогда не постучится.
    define v_addtargets: [user, service_account, group#member] or v_update
    define v_removetargets: [user, service_account, group#member] or v_update

# KAC-178 §4: nlb_listener — first-class FGA object для Listener (design §3.3).
# Contract-A (flat model): listener does not INHERIT permissions from its parent
# load balancer — access is materialized per-object (reconciler).
#
# A `load_balancer: [nlb_network_load_balancer]` parent-pointer stood here and is
# gone. It was the residue of a closed incident: nlb used to emit it, the proxy
# rule refuses it (a module writes ownership links, and this was not one), so it
# was refused on every delivery and nlb stopped emitting it. What remained was a
# declaration NOBODY WROTE, while the comment above it described it as a live
# structural pointer — and nothing derived over it either. A relation no producer
# writes still reads as a working link to the next author. Held by
# TestConsumerOwnedStructuralRelationsHaveProducers: it reddens with the
# coordinate of any structural relation on a consumer-owned type that has no
# producer and no explicit latency marker.
#
# api-gateway permission_catalog.json keyed на этот type для
# Listener Get/Update/Delete/ListOperations (PR PRO-Robotech/kacho-api-gateway#37).
type nlb_listener
  relations
    # #68: nlb emits `nlb_listener #project @project` (fga_intent.go) parity with
    # nlb_network_load_balancer / nlb_target_group; without this relation the engine
    # rejected the tuple → drainer dead-lettered it → listener hierarchy never
    # materialized → listener authz broke. Contract-A direct project link.
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin

# ---------------------------------------------------------------------------
# registry (kacho-registry) — namespace-реестр (registry_registry) и per-repo
# authz-объект (registry_repository). Flat verb-bearing (как vpc/lb): v_* —
# прямые, развязаны от tier. `project` линкует реестр к проекту, `owner` несёт
# creator-tuple (registry пишет owner через RegisterResource). Репозиторий —
# child реестра (`parent`), доступ материализуется per-object реконсайлером.
# ---------------------------------------------------------------------------

type registry_registry
  relations
    define project: [project]
    define super_admin: super_admin from project
    define owner: [user, service_account]
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    # #64 Defect A: v_* derive from `owner` so a registry's CREATOR/OWNER (the
    # RegisterResource `owner` tuple) holds the full CRUD verb-set on their own
    # registry — esp. v_create (create repositories). Without this the owner got
    # only editor-tier v_get/v_list/v_update/v_delete (the `edit` role authors no
    # `create` verb) and CreateRepository denied → 404 for the owner. Per-OBJECT
    # computed relation (like `editor: this or admin`), NOT a hierarchy cascade.
    #
    # `v_create` LIVES HERE AND NOWHERE ELSE — do not "restore parity" by adding it
    # back to the other types. A registry is a CONTAINER: "create a repository in
    # this namespace" is a real operation on the registry object, and it is really
    # asked — by the control plane (CreateRepository / RenameRepository) and by the
    # data plane (docker push to a new repo, cross-repo mount into a new dst, and
    # the first-push blob-reveal guard). Every other type answered a question no
    # request ever asks: "create" is not an operation on an already-existing object,
    # and creating a resource inside a scope is authorized by the write tier on that
    # scope. Locked by authzmap/verb_relation_has_reader_test.go, which reds with the
    # type name if a reader-less carrier reappears.
    define v_get: [user, service_account, group#member] or owner or super_admin
    define v_list: [user, service_account, group#member] or owner or super_admin
    define v_create: [user, service_account, group#member] or owner or super_admin
    define v_update: [user, service_account, group#member] or owner or super_admin
    define v_delete: [user, service_account, group#member] or owner or super_admin

type registry_repository
  relations
    define parent: [registry_registry]
    # A repository has no project pointer of its own — it is a child of its
    # registry, and the registry is the one anchored to a project.
    define super_admin: super_admin from parent
    define owner: [user, service_account]
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    # RG-1 D-7: `user:*` public-read wildcard — anonymous pull of a PUBLIC repo.
    # The wildcard grants v_get ONLY on repos that ALSO carry an explicit
    # `user:* v_get` tuple emitted by the registry overlay (visibility=PUBLIC);
    # absent that tuple `user:*` has no access → uniform 404. ONLY v_get gains
    # the wildcard — no write relation does (anon is a read-only floor, B14).
    # #64 Defect A: v_* derive from `owner` (repo creator/pusher owner-tuple) so
    # the repo owner fully manages their own repository; `user:*` wildcard stays
    # on v_get ONLY (anonymous public-read floor, B14).
    define v_get: [user:*, user, service_account, group#member] or owner or super_admin
    define v_list: [user, service_account, group#member] or owner or super_admin
    define v_update: [user, service_account, group#member] or owner or super_admin
    define v_delete: [user, service_account, group#member] or owner or super_admin

# ---------------------------------------------------------------------------
# storage (kacho-storage) — Volume / Snapshot / Image per-object authz types.
# #71: the storage owner-registration edge (storage→iam RegisterResource,
# SEC-D / CS-1 GAP-D) emits `storage_<t>:<id> #project @project:<proj>` for every
# Volume/Snapshot/Image (services/storage/.../fgaregister.go). These TYPES were
# ABSENT from the model → the engine rejected every storage owner-tuple ("type
# 'storage_volume' not found") → drainer permanent-poison → the resource's
# project hierarchy never materialized → the gateway anti-BOLA scope_extractor
# {storage_volume,volume_id} / {storage_snapshot,snapshot_id} / {storage_image,
# image_id} on Get/Update/Delete could not resolve target→project → the object-
# self Check errored → production fail-closed → 403 for the OWNER on their OWN
# volume (verified live: owner-GET 403, cross-GET 403 — fail-CLOSED gap, NOT BOLA).
# Fix = flat Contract-A parity with nlb_network_load_balancer / nlb_listener:
# `project: [project]` (structural link, reconciler materializes per-object v_*
# from the creator's project binding) + DIRECT v_*. Storage emits ONLY the
# `project` tuple (no `owner` tuple — unlike registry), so NO `or owner`
# derivation: it would be an inert dead relation (LEAN / ban #11).
# ---------------------------------------------------------------------------

type storage_volume
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin

type storage_snapshot
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin

type storage_image
  relations
    define project: [project]
    define super_admin: super_admin from project
    define admin: [user, service_account, group#member] or super_admin
    define editor: [user, service_account, group#member] or admin
    define viewer: [user, service_account, group#member] or editor
    define v_get: [user, service_account, group#member] or super_admin
    define v_list: [user, service_account, group#member] or super_admin
    define v_update: [user, service_account, group#member] or super_admin
    define v_delete: [user, service_account, group#member] or super_admin

# ---------------------------------------------------------------------------
# Conditions catalog — 7 frozen built-ins (acceptance §4.5).
# ---------------------------------------------------------------------------

condition mfa_fresh(amr_claims: list<string>, acr_value: string, current_time: timestamp, mfa_at: timestamp) {
  acr_value == "3" &&
  "webauthn" in amr_claims &&
  current_time - mfa_at < duration("15m")
}

condition non_expired(current_time: timestamp, valid_until: timestamp) {
  current_time < valid_until
}

condition source_ip_in_range(client_ip: ipaddress, allowed_cidrs: list<string>) {
  allowed_cidrs.exists(c, client_ip.in_cidr(c))
}

condition jit_window(current_time: timestamp, activated_at: timestamp, ttl_seconds: int) {
  current_time - activated_at < duration(string(ttl_seconds) + "s")
}

condition business_hours(current_time: timestamp, tz: string, start_h: int, end_h: int) {
  current_time.getHours(tz) >= start_h && current_time.getHours(tz) < end_h
}

condition device_compliant(device_attestation: string, allowed_attestations: list<string>) {
  device_attestation in allowed_attestations
}
