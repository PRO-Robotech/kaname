{
  "info": {
    "_postman_id": "4b6e25d1-04ae-5211-8212-62000f1244f0",
    "name": "kacho-iam / newman / iam-system-grant-visibility",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId') || pm.environment.get('runId') === '') {",
          "  // runId формат: только [a-z0-9], без точки, начинается с буквы — чтобы проходить compute name regex",
          "  const t = Date.now().toString(36);",
          "  const r = Math.floor(Math.random() * 1e9).toString(36);",
          "  pm.environment.set('runId', ('r' + t + r).replace(/[^a-z0-9]/g, '').slice(0, 11));",
          "}",
          "pm.environment.set('_suiteProjectId', pm.environment.get('existingProjectId'));",
          "pm.environment.set('_suiteFolderCrossId', pm.environment.get('existingProjectCrossId'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "try {",
          "  const _ct = (pm.response && pm.response.headers && pm.response.headers.get('Content-Type')) || '';",
          "  if (_ct.indexOf('json') !== -1) {",
          "    const _j = pm.response.json();",
          "    if (_j && _j.done === true && typeof _j.id === 'string' && _j.id !== '') {",
          "      if (_j.error) {",
          "        const _pv = JSON.parse(pm.environment.get('_provisionalIds') || '[]');",
          "        _pv.forEach(function (k) { pm.environment.unset(k); });",
          "      }",
          "      pm.environment.unset('_provisionalIds');",
          "    }",
          "  }",
          "} catch (e) { /* не JSON, не Operation — регистрация остаётся как есть */ }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "IAM-ACB-SYSGRANT-VISIBLE-OK — GET /iam/v1/accessBindings as jwtBootstrap → 200; системные выдачи видны, несут grantedRelation без roleId, среди них есть подстановочный субъект",
      "description": "class:CONF | class:AUTHZ | priority:P0",
      "item": [
        {
          "name": "IAM-ACB-SYSGRANT-VISIBLE-OK :: list-access-bindings-as-cluster-admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iam/v1/accessBindings?pageSize=1000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iam",
                "v1",
                "accessBindings?pageSize=1000"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// per-step auth: bearer from env 'jwtBootstrap'",
                  "const __t = pm.environment.get('jwtBootstrap') || pm.variables.get('jwtBootstrap') || '';",
                  "if (__t) {",
                  "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __t});",
                  "} else {",
                  "  pm.test('harness config: jwtBootstrap is set (subject under test)', () => {",
                  "    pm.expect.fail('jwtBootstrap is not set — the authz-fixture seed (tests/authz-fixtures/setup.sh) did not provide this subject. Running the step anonymously would test a DIFFERENT principal and pass for the wrong reason.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}",
                  "(function () {",
                  "  var _u = '';",
                  "  try { _u = pm.request.url.toString(); } catch (e) { return; }",
                  "  try {",
                  "    if (pm.request.body && pm.request.body.raw) { _u = _u + ' ' + pm.request.body.raw; }",
                  "  } catch (e) { /* тела может не быть — это не находка */ }",
                  "  var _all = _u.match(/\\{\\{[A-Za-z0-9_]+\\}\\}/g);",
                  "  if (!_all) { return; }",
                  "  var _n = null;",
                  "  for (var _i = 0; _i < _all.length; _i++) {",
                  "    var _c = _all[_i].slice(2, -2);",
                  "    if (!pm.variables.has(_c)) { _n = _c; break; }",
                  "  }",
                  "  if (_n === null) { return; }",
                  "  pm.test('предусловие: {{' + _n + '}} не было захвачено — запрос не отправлен', function () {",
                  "    pm.expect.fail(_n + ' не определена ни в одной области. Мутация, которая должна была её захватить, не вернула Operation (была отвергнута), либо захват не состоялся. Отправка ушла бы литералом и повтор не сошёлся бы никогда.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.expect(pm.response.code, JSON.stringify(pm.response.text())).to.eql(200));",
                  "pm.test('ответ несёт непустой массив выдач', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.accessBindings, JSON.stringify(j)).to.be.an('array');",
                  "  pm.expect(j.accessBindings.length, 'выдач на странице').to.be.greaterThan(0);",
                  "});",
                  "pm.test('встроенный доступ ВИДЕН: есть системные выдачи', () => {",
                  "  const all = pm.response.json().accessBindings || [];",
                  "  const sys = all.filter(b => b.system === true);",
                  "  pm.expect(sys.length, 'системных выдач в ответе (всего строк ' + all.length + ')')",
                  "    .to.be.greaterThan(0);",
                  "});",
                  "pm.test('у системной выдачи ВТОРАЯ форма: отношение без роли', () => {",
                  "  const sys = (pm.response.json().accessBindings || []).filter(b => b.system === true);",
                  "  sys.forEach(b => {",
                  "    pm.expect(b.grantedRelation, 'grantedRelation у ' + b.id).to.be.a('string').and.not.equal('');",
                  "    pm.expect(b.roleId || '', 'roleId у системной выдачи ' + b.id + ' обязан быть пуст')",
                  "      .to.equal('');",
                  "  });",
                  "});",
                  "pm.test('публичное чтение справочника: есть выдача подстановочному субъекту', () => {",
                  "  const sys = (pm.response.json().accessBindings || []).filter(b => b.system === true);",
                  "  const wildcard = sys.filter(b => b.subjectId === '*');",
                  "  pm.expect(wildcard.length, 'выдач субъекту «любой аутентифицированный» среди ' + sys.length)",
                  "    .to.be.greaterThan(0);",
                  "  wildcard.forEach(b => {",
                  "    pm.expect(b.subjectType, 'тип подстановочного субъекта').to.equal('user');",
                  "  });",
                  "});",
                  "pm.test('ЗАКОННЫЙ БЛИЗНЕЦ: обычная выдача в том же ответе — с ролью и без признака', () => {",
                  "  // Без этого утверждения проба зеленела бы и на ответе, где системными",
                  "  // объявлены все строки подряд, — то есть на потере различия, ради",
                  "  // которого признак и заведён.",
                  "  const all = pm.response.json().accessBindings || [];",
                  "  const ordinary = all.filter(b => b.system !== true);",
                  "  pm.expect(ordinary.length, 'обычных выдач в ответе').to.be.greaterThan(0);",
                  "  ordinary.forEach(b => {",
                  "    pm.expect(b.roleId, 'roleId у обычной выдачи ' + b.id).to.be.a('string').and.not.equal('');",
                  "    pm.expect(b.grantedRelation || '', 'grantedRelation у обычной выдачи ' + b.id + ' пуст')",
                  "      .to.equal('');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": []
}
