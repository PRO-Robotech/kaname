    {
      "name": "IAM-AB-SIA-12-EDGE-LIST-BY-ACCOUNT — IAM-AB-SIA-12: /accounts/not-an-id/accessBindings → 400 INVALID_ARGUMENT, \"invalid resource id 'not-an-id'\" — у цели авторизации производитель отказа формы КРАЙ",
      "description": "class:NEG | class:VAL | priority:P0",
      "item": [
        {
          "name": "IAM-AB-SIA-12-EDGE-LIST-BY-ACCOUNT :: sia-malformed-parity-with-list-by-account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/iam/v1/accounts/not-an-id/accessBindings?pageSize=100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "iam",
                "v1",
                "accounts",
                "not-an-id",
                "accessBindings?pageSize=100"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// per-step auth: bearer from env 'jwtAccountAdminA'",
                  "const __t = pm.environment.get('jwtAccountAdminA') || pm.variables.get('jwtAccountAdminA') || '';",
                  "if (__t) {",
                  "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __t});",
                  "} else {",
                  "  pm.test('[УСЛОВИЕ НЕ СОЗДАНО] harness config: jwtAccountAdminA is set (subject under test)', () => {",
                  "    pm.expect.fail('jwtAccountAdminA is not set — the authz-fixture seed (tests/authz-fixtures/setup.sh) did not provide this subject. Running the step anonymously would test a DIFFERENT principal and pass for the wrong reason.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "}",
                  "(function () {",
                  "  var _u = '';",
                  "  try { _u = pm.request.url.toString(); } catch (e) { return; }",
                  "  try {",
                  "    if (pm.request.body && pm.request.body.raw) { _u = _u + ' ' + pm.request.body.raw; }",
                  "  } catch (e) { /* тела может не быть — это не находка */ }",
                  "  var _all = _u.match(/\\{\\{[A-Za-z0-9_]+\\}\\}/g);",
                  "  if (!_all) { return; }",
                  "  var _n = null;",
                  "  for (var _i = 0; _i < _all.length; _i++) {",
                  "    var _c = _all[_i].slice(2, -2);",
                  "    if (!pm.variables.has(_c)) { _n = _c; break; }",
                  "  }",
                  "  if (_n === null) { return; }",
                  "  pm.test('предусловие: {{' + _n + '}} не было захвачено — запрос не отправлен', function () {",
                  "    pm.expect.fail(_n + ' не определена ни в одной области. Мутация, которая должна была её захватить, не вернула Operation (была отвергнута), либо захват не состоялся. Отправка ушла бы литералом и повтор не сошёлся бы никогда.');",
                  "  });",
                  "  pm.execution.skipRequest();",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.expect(pm.response.code, JSON.stringify(pm.response.text())).to.eql(400));",
                  "pm.test('grpc code 3 (INVALID_ARGUMENT)', () => {",
                  "  let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "  pm.expect(j.code, JSON.stringify(j)).to.eql(3);",
                  "});",
                  "pm.test('у цели авторизации отказ формы производит край, и текст его', () =>",
                  "  pm.expect(pm.response.json().message, pm.response.text())",
                  "    .to.eql(\"invalid resource id 'not-an-id'\"));"
                ]
              }
            }
          ]
        }
      ]
