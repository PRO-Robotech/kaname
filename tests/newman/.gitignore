# Newman run artifacts — generated by tests/newman/scripts/run.sh.
# Never commit: stale out/*.json pollute the CI `assert authz suites green`
# step (run.sh's summary iterates out/*.json — a leftover authz-deny-rerun.json
# from a local run resurfaced as a 511-failure phantom suite in newman-e2e).
out/

# Файл окружения прогона — НИКОГДА не коммитится: посев пишет в него ЖИВЫЕ
# предъявители (`tests/authz-fixtures/seed_own_stand.py` кладёт туда четыре
# Bearer-токена нашей чеканки), а репозиторий ПУБЛИЧЕН.
#
# Правило заведено вместе с первым посевом этого дерева, и до него его не было:
# `scripts/run.sh` утверждал «env-файл gitignore-ится», материализовал файл из
# шаблона сам — и `git status` показывал его неотслеживаемым. Пока в него писали
# только идентификаторы, цена была нулевой; с живыми токенами один `git add -A`
# уносит их в публичную историю, откуда изъятие уже не восстанавливает секрет.
#
# Шаблон (`*.template.json`) ОТСЛЕЖИВАЕТСЯ и должен: в нём пустые значения, и
# именно он — объявление того, какие ключи набор читает.
environments/local.postman_environment.json
